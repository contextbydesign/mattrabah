---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/ui/Tag.astro";
import Lozenge from "../../components/lozenge.astro";

const tools = [
  {
    title: "Handoff Risk Checker",
    status: "progress",
    label: "Prototype",
    body: "Reads a sales promise, stakeholder map, and known constraints, then flags what's likely to become an implementation problem after the customer says yes.",
    inputs: ["Sales promise", "Stakeholders", "Timeline", "Constraints"],
  },
  {
    title: "Customer Health Signal Mapper",
    status: "progress",
    label: "Prototype",
    body: "Turns scattered account signals into likely risk patterns, root causes, and a next action. Built for account reviews and portfolio triage.",
    inputs: [
      "Usage signals",
      "Relationship changes",
      "Support volume",
      "Renewal timing",
    ],
  },
  {
    title: "Renewal Readiness Diagnostic",
    status: "planned",
    label: "Planned",
    body: "Tests whether an account is operationally, commercially, and relationship-ready for renewal — before the date forces the conversation.",
    inputs: ["Adoption", "Sponsor", "Business value", "Open risks"],
  },
  {
    title: "QBR Question Builder",
    status: "planned",
    label: "Planned",
    body: "Builds executive review questions around decisions, value, and unresolved risk instead of letting the QBR collapse into a recap deck.",
    inputs: ["Account stage", "Outcomes", "Open risks", "Expansion"],
  },
  {
    title: "CRM Field Quality Checker",
    status: "planned",
    label: "Planned",
    body: "Checks whether a CRM field has a real owner, a useful cadence, and a customer-facing decision it actually supports — or whether it's just noise.",
    inputs: ["Field", "Owner", "Cadence", "Decision"],
  },
];
---

<BaseLayout
  title="Tools"
  description="Practical AI tools from Matt Rabah for CX, customer success, and implementation teams — handoff risk, account health, renewal readiness."
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow reveal reveal-1">Practical AI</p>
      <h1 class="display reveal reveal-2">Small tools for real problems.</h1>
      <p
        class="lead reveal reveal-3"
        style="max-width:48ch; margin-top:var(--space-6)"
      >
        Honest prototypes that reduce the friction teams trip over: handoffs,
        hidden risks, and renewal readiness that shows up before the date.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container tool-grid">
      {
        tools.map((t) => (
          <article class="tool">
            <div class="tool-head">
              <h2 class="h3">{t.title}</h2>
              <Lozenge label={t.label} status={t.status as any} />
            </div>
            <p class="body" style="max-width:50ch">
              {t.body}
            </p>
            <div class="chip-row">
              {t.inputs.map((i) => (
                <Tag text={i} />
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <style>
    .hero {
      padding-block: clamp(var(--space-9), 14vw, 9rem) var(--space-8);
    }
    .tool-grid {
      display: grid;
      gap: 0;
    }
    .tool {
      display: grid;
      gap: var(--space-4);
      padding: var(--space-7) 0;
      border-top: 1px solid var(--color-border);
    }
    .tool:last-child {
      border-bottom: 1px solid var(--color-border);
    }
    .tool-head {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      flex-wrap: wrap;
    }
    .chip-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
  </style>
</BaseLayout>
