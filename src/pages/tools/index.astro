---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tag from "../components/ui/Tag.astro";

const toolItems = [
  {
    title: "Health Score Diagnostic",
    subtitle: "Account Risk Assistant",
    summary:
      "A lightweight prompt engine designed to parse qualitative account notes and flag churn risk long before the renewal window opens.",
    tags: ["Prompt Engineering", "Account Health", "Risk Mitigation"],
  },
  {
    title: "QBR Synthesizer",
    subtitle: "Meeting Prep Automation",
    summary:
      "A structured workflow that ingests recent support tickets and usage data to generate executive summaries, saving hours of manual prep.",
    tags: ["Data Synthesis", "Workflow Automation", "Executive Prep"],
  },
  {
    title: "Handoff Optimizer",
    subtitle: "Sales to CS Alignment",
    summary:
      "A framework that audits closed-won CRM fields and outputs a clean, actionable brief for the implementation team, reducing initial friction.",
    tags: ["CRM Hygiene", "Change Management", "Process Design"],
  },
];
---

<BaseLayout
  title="AI Tools"
  description="Practical AI workflows and operational tools designed by Matt Rabah."
>
  <section class="hero container">
    <p class="kicker">AI Tools</p>

    <h1 class="display">AI should reduce friction, not add noise.</h1>

    <p class="lead">
      We don't need more tools; we need better judgment. I build lightweight AI workflows designed to solve actual operational bottlenecks. These prototypes target things like handoff risk, account triage, and the "input blindness" that plagues most CRM environments.
    </p>
  </section>

  <section class="section container" aria-labelledby="tool-list">
    <header class="section-head">
      <h2 class="section-title" id="tool-list">Active frameworks</h2>
    </header>

    <ul class="work-list work-list--full">
      {
        toolItems.map((entry) => (
          <li class="work-list-item">
            <div class="work-link">
              <p class="kicker">{entry.subtitle}</p>
              <h3 class="work-title">{entry.title}</h3>
              <p class="work-summary">{entry.summary}</p>
              <ul class="capabilities-tags" aria-label={`${entry.title} tags`}>
                {entry.tags.map((tag) => (
                  <li>
                    <Tag label={tag} />
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>