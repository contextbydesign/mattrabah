---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/ui/Tag.astro";

const tools = [
  {
    title: "Handoff Risk Checker",
    status: "Prototype",
    summary:
      "Checks whether a promised timeline, stakeholder map, or known constraint is likely to become an implementation problem after the customer says yes.",
    inputs: ["Sales promise", "Stakeholders", "Timeline", "Known constraints"],
  },
  {
    title: "Customer Health Signal Mapper",
    status: "Prototype",
    summary:
      "Turns account signals into likely risk patterns, root causes, and next actions. Built for account review, portfolio triage, and cleaner follow-up.",
    inputs: [
      "Usage signals",
      "Relationship changes",
      "Support volume",
      "Renewal timing",
    ],
  },
  {
    title: "Renewal Readiness Diagnostic",
    status: "Planned",
    summary:
      "Tests whether an account is operationally, commercially, and relationship-ready for renewal before the renewal date forces the conversation.",
    inputs: ["Adoption", "Executive sponsor", "Business value", "Open risks"],
  },
  {
    title: "QBR Question Builder",
    status: "Planned",
    summary:
      "Builds executive review questions around decisions, value, unresolved risk, and future commitment instead of turning the QBR into a recap deck.",
    inputs: [
      "Account stage",
      "Known outcomes",
      "Open risks",
      "Expansion potential",
    ],
  },
  {
    title: "CRM Field Quality Checker",
    status: "Planned",
    summary:
      "Reviews whether a CRM field has a real owner, a useful update cadence, and a customer-facing decision it actually supports.",
    inputs: ["Field name", "Owner", "Update cadence", "Decision supported"],
  },
];
---

<BaseLayout
  title="AI Tools"
  description="Practical AI tools from Matt Rabah for CX, customer success, implementation, account health, CRM discipline, and customer lifecycle teams."
>
  <section class="hero container">
    <p class="kicker">AI tools</p>

    <h1 class="display">Tools for the handoff gaps.</h1>

    <p class="lead">
      Practical prototypes for customer-facing teams: handoff risk, customer
      health, renewal readiness, and account prep.
    </p>
  </section>

  <section class="section container" aria-labelledby="tool-list">
    <header class="section-head">
      <h2 class="section-title" id="tool-list">Tool prototypes</h2>
    </header>

    <ul class="work-list work-list--full">
      {
        tools.map((tool) => (
          <li class="work-list-item">
            <a href="/tools" class="work-link">
              <p class="kicker">{tool.status}</p>
              <h3 class="work-title">{tool.title}</h3>
              <p class="work-summary">{tool.summary}</p>

              <ul class="capabilities-tags" aria-label={`${tool.title} inputs`}>
                {tool.inputs.map((input) => (
                  <li>
                    <Tag text={input} variant="muted" size="sm" />
                  </li>
                ))}
              </ul>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
