---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/ui/Tag.astro";
import Lozenge from "../../components/Lozenge.astro";
import Card from "../../components/Card.astro";

const tools = [
  {
    title: "Handoff Risk Checker",
    status: "Prototype",
    appearance: "inprogress",
    body: "Checks whether a promised timeline, stakeholder map, or known constraint is likely to become an implementation problem after the customer says yes.",
    inputs: ["Sales promise", "Stakeholders", "Timeline", "Known constraints"],
  },
  {
    title: "Customer Health Signal Mapper",
    status: "Prototype",
    appearance: "inprogress",
    body: "Turns account signals into likely risk patterns, root causes, and next actions. Built for account review, portfolio triage, and cleaner follow-up.",
    inputs: [
      "Usage signals",
      "Relationship changes",
      "Support volume",
      "Renewal timing",
    ],
  },
  {
    title: "Renewal Readiness Diagnostic",
    status: "Planned",
    appearance: "new",
    body: "Tests whether an account is operationally, commercially, and relationship-ready for renewal before the date forces the conversation.",
    inputs: ["Adoption", "Executive sponsor", "Business value", "Open risks"],
  },
  {
    title: "QBR Question Builder",
    status: "Planned",
    appearance: "new",
    body: "Builds executive review questions around decisions, value, unresolved risk, and future commitment instead of turning the QBR into a recap deck.",
    inputs: [
      "Account stage",
      "Known outcomes",
      "Open risks",
      "Expansion potential",
    ],
  },
  {
    title: "CRM Field Quality Checker",
    status: "Planned",
    appearance: "new",
    body: "Reviews whether a CRM field has a real owner, a useful update cadence, and a customer-facing decision it actually supports.",
    inputs: ["Field name", "Owner", "Update cadence", "Decision supported"],
  },
];
---

<BaseLayout
  title="AI Tools"
  description="Practical AI tools from Matt Rabah for CX, customer success, implementation, account health, and CRM discipline."
>
  <section class="container section hero">
    <div class="stack-300">
      <p class="heading-xxs text-brand">AI tools</p>
      <h1 class="heading-xxl" style="max-width:14ch">
        Tools for the handoff gaps.
      </h1>
      <p class="body-l measure">
        Practical prototypes for customer-facing teams: handoff risk, customer
        health, renewal readiness, and account prep.
      </p>
    </div>
  </section>

  <section class="container section">
    <div class="card-grid">
      {
        tools.map((t) => (
          <Card href="/tools">
            <div class="stack-100">
              <Lozenge label={t.status} appearance={t.appearance as any} />
              <h2 class="heading-m">{t.title}</h2>
              <p class="body">{t.body}</p>
              <div class="tag-row">
                {t.inputs.map((i) => (
                  <Tag text={i} />
                ))}
              </div>
            </div>
          </Card>
        ))
      }
    </div>
  </section>

  <style>
    .hero {
      padding-block: clamp(var(--space-800), 12vw, 7rem);
    }
    .measure {
      max-width: 46rem;
      color: var(--color-text-subtle);
    }
    .card-grid {
      display: grid;
      gap: var(--space-200);
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    }
    .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-100);
      margin-top: var(--space-050);
    }
  </style>
</BaseLayout>
