---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Get in touch with me"
>
  <section class="hero container">
    <p class="kicker">Contact</p>

    <h1 class="display">Let's build something that works.</h1>

    <p class="lead">
      If your team is wrestling with a complex customer lifecycle, trying to figure out practical AI workflows, or just needs to fix the CRM plumbing, let's talk.
    </p>

    <div style="margin-top: var(--s-lg);">
      <a
        href="mailto:rabah.matthew@gmail.com"
        style="
          display: inline-block;
          background: var(--c-accent);
          color: white;
          padding: 0.8rem 1.6rem;
          text-decoration: none;
          font-weight: 500;
          border-radius: var(--r-sm);
          font-family: var(--ff-sans);
          transition: background-color var(--ms-base);
        "
        onmouseover="this.style.backgroundColor='var(--c-accent-ink)'"
        onmouseout="this.style.backgroundColor='var(--c-accent)'"
      >
        Email me directly
      </a>
    </div>
  </section>
</BaseLayout>