---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";

const links = [
  {
    label: "Email",
    value: "rabah.matthew@gmail.com",
    href: "mailto:rabah.matthew@gmail.com",
    external: false,
    icon: "M4.75 6.75h14.5v10.5H4.75zM5.25 7.25l6.75 5 6.75-5",
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/mattrabah",
    href: "https://linkedin.com/in/mattrabah",
    external: true,
    icon: "M6.7 9.4v8.15M6.7 6.75h.02M11 17.55v-8.1M11 12.35c.45-1.85 1.65-3.05 3.35-3.05 2.05 0 3.15 1.35 3.15 3.75v4.5",
  },
  {
    label: "Instagram",
    value: "@contextbydesign.io",
    href: "https://www.instagram.com/contextbydesign.io",
    external: true,
    icon: "M12 8.55a3.45 3.45 0 1 0 0 6.9 3.45 3.45 0 0 0 0-6.9",
  },
];
---

<BaseLayout
  title="Contact"
  description="Contact Matt Rabah about customer lifecycle systems, customer success, implementation, CRM discipline, and practical AI workflow work."
>
  <section class="container section hero">
    <div class="stack-300">
      <p class="heading-xxs text-brand">Contact</p>
      <h1 class="heading-xxl" style="max-width:14ch">
        Start the conversation.
      </h1>
      <p class="body-l measure">
        Tell me where the customer lifecycle is breaking, or what you're hiring
        for. I read every message and reply with a clear next step.
      </p>
    </div>
  </section>

  <section class="container section">
    <header class="section-head">
      <h2 class="heading-l">Reach me directly</h2>
    </header>
    <div class="contact-grid">
      {
        links.map((l) => (
          <Card href={l.href} external={l.external}>
            <div class="contact-row">
              <span class="contact-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={l.icon} />
                </svg>
              </span>
              <span class="stack-100">
                <span class="heading-s">{l.label}</span>
                <span class="body text-subtlest">{l.value}</span>
              </span>
            </div>
          </Card>
        ))
      }
    </div>
  </section>

  <style>
    .hero {
      padding-block: clamp(var(--space-800), 12vw, 7rem);
    }
    .measure {
      max-width: 46rem;
      color: var(--color-text-subtle);
    }
    .section-head {
      margin-bottom: var(--space-300);
    }
    .contact-grid {
      display: grid;
      gap: var(--space-200);
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    }
    .contact-row {
      display: flex;
      align-items: center;
      gap: var(--space-200);
    }
    .contact-icon {
      display: inline-grid;
      place-items: center;
      flex: none;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: var(--radius-200);
      background: var(--color-background-brand-subtlest);
      color: var(--color-text-brand);
    }
    .contact-icon svg {
      width: 1.4rem;
      height: 1.4rem;
    }
  </style>
</BaseLayout>
