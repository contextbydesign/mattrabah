---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Contact Matt Rabah for customer success, customer experience, implementation, and lifecycle systems work."
>
  <section class="hero container">
    <p class="kicker">Contact</p>

    <h1 class="display">
      For customer lifecycle, implementation, and CX work, start here.
    </h1>

    <p class="lead">
      I am based in the Detroit area and focused on Customer Success, Customer
      Experience, Implementation, Account Management, and CRM-adjacent roles or
      projects.
    </p>
  </section>

  <section class="section container" aria-labelledby="contact-options">
    <header class="section-head">
      <h2 class="section-title" id="contact-options">Contact options</h2>
    </header>

    <ul class="writing-list">
      <li class="writing-list-item">
        <a href="mailto:hello@mattrabah.com" class="writing-link">
          <p class="meta">Email</p>
          <h3 class="writing-title">hello@mattrabah.com</h3>
          <p class="writing-dek">
            Best for role conversations, project inquiries, and professional
            follow-up.
          </p>
        </a>
      </li>

      <li class="writing-list-item">
        <a
          href="https://www.linkedin.com/in/mattrabah/"
          rel="me noopener"
          target="_blank"
          class="writing-link"
        >
          <p class="meta">LinkedIn</p>
          <h3 class="writing-title">Connect on LinkedIn</h3>
          <p class="writing-dek">
            Best for recruiter outreach, hiring conversations, and professional
            context.
          </p>
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>