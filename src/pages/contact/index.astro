---
import BaseLayout from "../../layouts/BaseLayout.astro";

const links = [
  {
    label: "Email",
    value: "rabah.matthew@gmail.com",
    href: "mailto:rabah.matthew@gmail.com",
    external: false,
    note: "Best for anything substantive.",
    icon: "M3.5 6.5h17v11h-17zM4 7l8 6 8-6",
  },
  {
    label: "LinkedIn",
    value: "/in/mattrabah",
    href: "https://linkedin.com/in/mattrabah",
    external: true,
    note: "Roles, referrals, and the full history.",
    icon: "M6.5 9.5v8M6.5 6.6h.02M11 17.5v-8M11 12.2c.4-1.8 1.6-3 3.3-3 2 0 3.2 1.3 3.2 3.7v4.6",
  },
  {
    label: "Instagram",
    value: "@contextbydesign.io",
    href: "https://www.instagram.com/contextbydesign.io",
    external: true,
    note: "The design and brand side of the work.",
    icon: "M7 4.5h10A2.5 2.5 0 0 1 19.5 7v10a2.5 2.5 0 0 1-2.5 2.5H7A2.5 2.5 0 0 1 4.5 17V7A2.5 2.5 0 0 1 7 4.5ZM12 8.7a3.3 3.3 0 1 0 0 6.6 3.3 3.3 0 0 0 0-6.6Z",
  },
];
---

<BaseLayout
  title="Contact"
  description="Contact Matt Rabah about CX, customer success, implementation, lifecycle systems, and practical AI workflow work."
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow reveal reveal-1">Contact</p>
      <h1 class="display reveal reveal-2">Start the conversation.</h1>
      <p
        class="lead reveal reveal-3"
        style="max-width:46ch; margin-top:var(--space-6)"
      >
        Tell me where the customer lifecycle is breaking — or what you're hiring
        for. I read every message and reply with a clear next step, not a form
        letter.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ul class="contact-list">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="contact"
                target={l.external ? "_blank" : undefined}
                rel={l.external ? "me noopener noreferrer" : undefined}
              >
                <span class="contact-icon" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d={l.icon} />
                  </svg>
                </span>
                <span class="contact-main">
                  <span class="h4">{l.label}</span>
                  <span class="meta contact-value">{l.value}</span>
                  <span class="body-sm">{l.note}</span>
                </span>
                <span class="contact-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <style>
    .hero {
      padding-block: clamp(var(--space-9), 14vw, 9rem) var(--space-8);
    }
    .contact-list {
      display: grid;
      gap: var(--space-4);
      max-width: 44rem;
    }
    .contact {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-5);
      align-items: center;
      padding: var(--space-5);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-surface-raised);
      box-shadow: var(--shadow-card);
      color: inherit;
      text-decoration: none;
      transition:
        transform var(--dur-2) var(--ease),
        box-shadow var(--dur-2) var(--ease),
        border-color var(--dur-1) var(--ease);
    }
    .contact:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-lift);
      border-color: var(--color-border-accent);
    }
    .contact:focus-visible {
      box-shadow: var(--focus-ring);
    }
    .contact-icon {
      display: inline-grid;
      place-items: center;
      flex: none;
      width: 3rem;
      height: 3rem;
      border-radius: var(--radius-md);
      background: var(--color-accent-bg);
      color: var(--color-text-accent);
    }
    .contact-icon svg {
      width: 1.45rem;
      height: 1.45rem;
    }
    .contact-main {
      display: grid;
      gap: var(--space-1);
    }
    .contact-value {
      color: var(--color-text-subtle);
    }
    .contact-arrow {
      color: var(--color-text-faint);
      transition:
        transform var(--dur-1) var(--ease),
        color var(--dur-1) var(--ease);
    }
    .contact:hover .contact-arrow {
      color: var(--color-text-accent);
      transform: translateX(4px);
    }
  </style>
</BaseLayout>
