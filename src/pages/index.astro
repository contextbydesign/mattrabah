---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tag from "../components/ui/Tag.astro";

const pillars = [
  {
    kicker: "Lifecycle Systems",
    title: "Make the customer lifecycle easier to operate.",
    summary:
      "Onboarding, adoption, account health, and renewal readiness should not live in scattered notes and heroic follow-up. They need a system the team can run when the account gets complicated.",
  },
  {
    kicker: "AI Workflow Design",
    title: "Use AI where it reduces drag, not judgment.",
    summary:
      "AI earns its place when it helps a team prepare faster, summarize context, and surface risk earlier. It becomes noise when it replaces ownership or adds one more place to check.",
  },
  {
    kicker: "Change Management",
    title: "Turn process into behavior people repeat.",
    summary:
      "A process that only works when everyone remembers it is not a process. I build the cadence, handoffs, and CRM discipline that hold up under real workload.",
  },
];

const featuredWork = [
  {
    kicker: "Healthtech",
    title: "NeuroSync",
    subtitle: "Customer Lifecycle Systems",
    summary:
      "Built the customer success function from the ground up across healthcare accounts, where onboarding, adoption, and renewal readiness had to hold up under clinical and operational pressure.",
    meta: "Healthtech · Customer Success · Implementation",
  },
  {
    kicker: "Brand-side retail",
    title: "Shinola",
    subtitle: "Portfolio Growth & CX Operations",
    summary:
      "Ran high-touch client experience, Salesforce process, and executive-facing account work at the Detroit flagship, where trust was earned one interaction at a time.",
    meta: "Retail · Client Experience · Operating Cadence",
  },
  {
    kicker: "Consulting",
    title: "Context By Design",
    subtitle: "Lifecycle Diagnostics & Retention",
    summary:
      "Built onboarding, retention, and lifecycle frameworks for service businesses that needed a clearer view of where customers stalled, churned, or lost confidence.",
    meta: "Consulting · Transformation · Retention Systems",
  },
];

const aiTools = [
  "Handoff Risk Checker",
  "Customer Health Signal Mapper",
  "Renewal Readiness Diagnostic",
];

const writing = [
  {
    title: "AI in CX fails when it starts with tools instead of workflows.",
    meta: "AI in CX · Draft",
  },
  {
    title: "The sales-to-implementation handoff is a risk control.",
    meta: "Implementation · Draft",
  },
  {
    title: "Customer health scores fail when no one owns the next action.",
    meta: "Customer Success · Draft",
  },
];
---

<BaseLayout
  title="Matt Rabah"
  description="Matt Rabah builds customer lifecycle systems, practical AI workflows, and operating models for customer-facing teams."
>
  <section class="hero container">
    <p class="kicker">CX systems · AI workflows</p>

    <h1 class="display">Systems that make customers easier to keep.</h1>

    <p class="lead">
      I am a Detroit-based CX and customer success professional. I build
      customer lifecycle systems, practical AI workflows, and operating rhythms
      for teams that need clearer ownership and fewer surprises near renewal.
    </p>
  </section>

  <section class="section container" aria-labelledby="home-intro">
    <header class="section-head">
      <h2 class="section-title" id="home-intro">What I focus on</h2>
    </header>

    <div class="capabilities">
      <p class="capabilities-prose">
        I work on the operating layer customers actually feel: how onboarding
        flows, who owns the next action, what survives a handoff, and where AI
        can cut administrative drag without blurring accountability. The
        industries change. The underlying problem does not.
      </p>

      <ul class="capabilities-tags" aria-label="Focus areas">
        <li><Tag text="Lifecycle systems" /></li>
        <li><Tag text="Implementation" /></li>
        <li><Tag text="Customer success" /></li>
        <li><Tag text="AI workflows" /></li>
        <li><Tag text="CRM discipline" /></li>
      </ul>
    </div>
  </section>

  <section class="section container" aria-labelledby="pillars">
    <header class="section-head">
      <h2 class="section-title" id="pillars">What I build</h2>
    </header>

    <ul class="work-list">
      {
        pillars.map((pillar) => (
          <li class="work-list-item">
            <div class="work-link">
              <p class="kicker">{pillar.kicker}</p>
              <h3 class="work-title">{pillar.title}</h3>
              <p class="work-summary">{pillar.summary}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    class="section section--dark container"
    aria-labelledby="selected-work"
  >
    <header class="section-head">
      <h2 class="section-title" id="selected-work">Selected work</h2>
      <a href="/work" class="section-more">All work →</a>
    </header>

    <ul class="work-list">
      {
        featuredWork.map((entry) => (
          <li class="work-list-item">
            <a href="/work" class="work-link">
              <p class="kicker">{entry.kicker}</p>
              <h3 class="work-title">{entry.title}</h3>
              <p class="work-summary">
                <strong>{entry.subtitle}</strong> — {entry.summary}
              </p>
              <p class="meta">{entry.meta}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container" aria-labelledby="ai-tools">
    <header class="section-head">
      <h2 class="section-title" id="ai-tools">Practical AI tools</h2>
      <a href="/tools" class="section-more">View tools →</a>
    </header>

    <div class="capabilities">
      <p class="capabilities-prose">
        The useful AI work is rarely flashy. It helps a team prepare for a
        handoff, read account risk, write a cleaner follow-up, or see what
        changed before the customer has to repeat it. That is the bar: less
        administrative drag, a clearer next action, better human judgment.
      </p>

      <ul class="capabilities-tags" aria-label="AI tool previews">
        {
          aiTools.map((tool) => (
            <li>
              <Tag text={tool} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section container" aria-labelledby="writing">
    <header class="section-head">
      <h2 class="section-title" id="writing">Writing</h2>
      <a href="/blog" class="section-more">All writing →</a>
    </header>

    <ul class="writing-list">
      {
        writing.map((entry) => (
          <li class="writing-list-item">
            <a href="/blog" class="writing-link">
              <p class="meta">{entry.meta}</p>
              <h3 class="writing-title">{entry.title}</h3>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container about-snapshot" aria-labelledby="about">
    <header class="section-head">
      <h2 class="section-title" id="about">About</h2>
      <a href="/about" class="section-more">More about me →</a>
    </header>

    <p class="about-prose">
      I have spent seven-plus years across healthtech, brand-side retail, and
      consulting, building the parts of the customer experience that decide
      whether people stay.
    </p>

    <p class="about-prose">
      My work makes the customer lifecycle less dependent on memory,
      personality, and rescue work. Clearer systems, better handoffs, cleaner
      operating cadence, and account visibility a team can act on.
    </p>
  </section>

  <section class="section container" aria-labelledby="contact">
    <header class="section-head">
      <h2 class="section-title" id="contact">Let's build the system.</h2>
      <a href="/contact" class="section-more">Contact →</a>
    </header>

    <p class="about-prose">
      If your customer lifecycle leans more on heroic individuals than on a
      working operating layer, that is the problem I am built for. Tell me where
      it is breaking.
    </p>
  </section>
</BaseLayout>
