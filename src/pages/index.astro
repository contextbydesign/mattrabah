---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tag from "../components/ui/Tag.astro";

const pillars = [
  {
    kicker: "Lifecycle Systems",
    title: "Make the customer lifecycle visible and manageable.",
    summary:
      "Onboarding, adoption, retention, account health, renewal readiness, and executive visibility organized into a usable operating model.",
  },
  {
    kicker: "AI Workflow Design",
    title: "Use AI where it reduces friction, not where it creates noise.",
    summary:
      "Practical tools and workflows that help customer-facing teams summarize context, surface risk, prepare follow-ups, and improve decision quality.",
  },
  {
    kicker: "Change Management",
    title: "Turn process changes into repeatable team behavior.",
    summary:
      "Operating cadence, stakeholder alignment, CRM discipline, enablement, and documentation that help teams actually adopt the system.",
  },
];

const featuredWork = [
  {
    kicker: "Healthtech",
    title: "NeuroSync",
    subtitle: "Customer Lifecycle Systems",
    summary:
      "Built and managed customer success workflows across healthcare accounts, with ownership across onboarding, adoption, account health, and renewal readiness.",
    meta: "Healthtech · Customer Success · Adoption & Implementation",
  },
  {
    kicker: "Brand-side retail",
    title: "Shinola",
    subtitle: "Portfolio Growth & CX Operations",
    summary:
      "Connected high-touch customer experience, portfolio growth, Salesforce process, and executive-facing account work inside a complex retail environment.",
    meta: "Brand-side Retail · Client Experience · Operating Cadence",
  },
  {
    kicker: "Consulting",
    title: "Context By Design",
    subtitle: "Lifecycle Diagnostics & Retention",
    summary:
      "Developed customer journey, onboarding, retention, and lifecycle frameworks for service businesses operating with limited process visibility.",
    meta: "Consulting · Transformation · Retention Systems",
  },
];

const aiTools = [
  {
    title: "Handoff Risk Checker",
    summary:
      "A structured prompt-based tool for identifying delivery risk before sales promises become implementation problems.",
  },
  {
    title: "Customer Health Signal Mapper",
    summary:
      "A lightweight tool for turning account signals into risk patterns, likely causes, and recommended next actions.",
  },
  {
    title: "Renewal Readiness Diagnostic",
    summary:
      "A guided checklist for assessing whether an account is commercially, operationally, and relationship-ready for renewal.",
  },
];

const writing = [
  {
    title: "AI in CX fails when it starts with tools instead of workflows.",
    meta: "AI in CX · Draft",
  },
  {
    title: "The sales-to-implementation handoff is a risk control.",
    meta: "Implementation · Draft",
  },
  {
    title: "Customer health scores fail when no one owns the next action.",
    meta: "Customer Success · Draft",
  },
];
---

<BaseLayout title="Matt Rabah">
  <section class="hero container">
    <p class="kicker">CX Management · AI Workflows · Change Management</p>

    <h1 class="display">
      Customer lifecycle systems, strengthened by practical AI workflows.
    </h1>

    <p class="lead">
      I help complex customer-facing teams improve onboarding, adoption, account
      health, retention, and executive visibility through clearer operating
      systems, better CRM discipline, and practical AI-enabled workflows.
    </p>
  </section>

  <section class="section container" aria-labelledby="pillars">
    <header class="section-head">
      <h2 class="section-title" id="pillars">What I build</h2>
    </header>

    <ul class="work-list">
      {
        pillars.map((pillar) => (
          <li class="work-list-item">
            <div class="work-link">
              <p class="kicker">{pillar.kicker}</p>
              <h3 class="work-title">{pillar.title}</h3>
              <p class="work-summary">{pillar.summary}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container" aria-labelledby="selected-work">
    <header class="section-head">
      <h2 class="section-title" id="selected-work">Selected work</h2>
      <a href="/work" class="section-more">All work →</a>
    </header>

    <ul class="work-list">
      {
        featuredWork.map((entry) => (
          <li class="work-list-item">
            <a href="/work" class="work-link">
              <p class="kicker">{entry.kicker}</p>
              <h3 class="work-title">{entry.title}</h3>
              <p class="work-summary">
                <strong>{entry.subtitle}</strong> — {entry.summary}
              </p>
              <p class="meta">{entry.meta}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container" aria-labelledby="ai-tools">
    <header class="section-head">
      <h2 class="section-title" id="ai-tools">
        Practical AI tools for CX, CS, and implementation teams.
      </h2>
      <a href="/tools" class="section-more">View tools →</a>
    </header>

    <div class="capabilities">
      <p class="capabilities-prose">
        These tools are designed around real customer-operations problems:
        handoff risk, account health, renewal readiness, executive preparation,
        and CRM discipline. They are not AI demos for their own sake. They are
        workflow aids for customer-facing teams.
      </p>

      <ul class="capabilities-tags" aria-label="AI tool previews">
        {
          aiTools.map((tool) => (
            <li>
              <Tag label={tool.title} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section container" aria-labelledby="writing">
    <header class="section-head">
      <h2 class="section-title" id="writing">Writing</h2>
      <a href="/blog" class="section-more">All writing →</a>
    </header>

    <ul class="writing-list">
      {
        writing.map((entry) => (
          <li class="writing-list-item">
            <a href="/blog" class="writing-link">
              <p class="meta">{entry.meta}</p>
              <h3 class="writing-title">{entry.title}</h3>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container about-snapshot" aria-labelledby="about">
    <header class="section-head">
      <h2 class="section-title" id="about">About</h2>
    </header>

    <p class="about-prose">
      I am a Detroit-based Customer Experience, Customer Success, and
      Implementation professional with experience across healthtech, brand-side
      retail, and consulting.
    </p>

    <p class="about-prose">
      My work connects customer lifecycle design, AI-enabled workflow adoption,
      CRM process, account health, implementation, retention, and
      executive-facing communication.
    </p>
  </section>
</BaseLayout>