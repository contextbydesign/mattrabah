---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import Lozenge from "../components/lozenge.astro";
import Tag from "../components/ui/Tag.astro";

const pillars = [
  {
    eyebrow: "Lifecycle systems",
    title: "Make the customer lifecycle easier to operate.",
    body: "Onboarding, adoption, account health, and renewal readiness shouldn't live in scattered notes and heroic follow-up. They need a system the team can run when the account gets complicated.",
  },
  {
    eyebrow: "AI workflow design",
    title: "Use AI where it reduces drag, not judgment.",
    body: "AI earns its place when it helps a team prepare faster, summarize context, and surface risk earlier. It becomes noise when it replaces ownership or adds one more place to check.",
  },
  {
    eyebrow: "Change management",
    title: "Turn process into behavior people repeat.",
    body: "A process that only works when everyone remembers it isn't a process. I build the cadence, handoffs, and CRM discipline that hold up under real workload.",
  },
];

const work = [
  {
    href: "/work#neurosync",
    eyebrow: "Healthtech",
    title: "NeuroSync",
    body: "Built the customer success function across healthcare accounts, where onboarding, adoption, and renewal readiness had to hold up under clinical and operational pressure.",
    tags: ["Customer success", "Implementation"],
  },
  {
    href: "/work#shinola",
    eyebrow: "Brand-side retail",
    title: "Shinola",
    body: "Ran high-touch client experience, Salesforce process, and executive-facing account work at the Detroit flagship, where trust was earned one interaction at a time.",
    tags: ["CX operations", "Portfolio growth"],
  },
  {
    href: "/work#context-by-design",
    eyebrow: "Consulting",
    title: "Context By Design",
    body: "Built onboarding, retention, and lifecycle frameworks for service businesses that needed a clearer view of where customers stalled, churned, or lost confidence.",
    tags: ["Lifecycle diagnostics", "Retention"],
  },
];

const tools = [
  {
    title: "Handoff Risk Checker",
    status: "Prototype",
    appearance: "inprogress",
  },
  {
    title: "Customer Health Signal Mapper",
    status: "Prototype",
    appearance: "inprogress",
  },
  {
    title: "Renewal Readiness Diagnostic",
    status: "Planned",
    appearance: "new",
  },
];

const writing = [
  {
    meta: "AI in CX",
    title: "AI in CX fails when it starts with tools instead of workflows.",
  },
  {
    meta: "Implementation",
    title: "The sales-to-implementation handoff is a risk control.",
  },
  {
    meta: "Customer success",
    title: "Customer health scores fail when no one owns the next action.",
  },
];
---

<BaseLayout
  title="Matt Rabah"
  description="Detroit-based CX and customer success. I build customer lifecycle systems, practical AI workflows, and operating models for customer-facing teams."
>
  <!-- HERO — practical first: who, where, what. Earn bold further down. -->
  <section class="container section hero">
    <div class="stack-300">
      <p class="heading-xxs text-brand">CX systems · AI workflows</p>
      <h1 class="heading-xxl hero-title">
        Systems that make customers easier to keep.
      </h1>
      <p class="body-l hero-lead">
        I'm a Detroit-based CX and customer success professional. I build
        customer lifecycle systems, practical AI workflows, and operating
        rhythms for teams that need clearer ownership and fewer surprises near
        renewal.
      </p>
      <div class="hero-actions">
        <Button href="/work" appearance="primary">See the work</Button>
        <Button href="/contact" appearance="subtle">Start a conversation</Button
        >
      </div>
    </div>
  </section>

  <!-- FOCUS — replaces the old "homepage is the front door" placeholder -->
  <section class="container section">
    <header class="section-head">
      <h2 class="heading-l">What I focus on</h2>
    </header>
    <div class="focus-grid">
      <p class="body-l">
        I work on the operating layer customers actually feel: how onboarding
        flows, who owns the next action, what survives a handoff, and where AI
        can cut administrative drag without blurring accountability. The
        industries change. The underlying problem doesn't.
      </p>
      <div class="tag-row">
        <Tag text="Lifecycle systems" />
        <Tag text="Implementation" color="blue" />
        <Tag text="Customer success" color="green" />
        <Tag text="AI workflows" color="teal" />
        <Tag text="CRM discipline" color="purple" />
      </div>
    </div>
  </section>

  <!-- PILLARS -->
  <section class="container section">
    <header class="section-head">
      <h2 class="heading-l">What I build</h2>
    </header>
    <div class="card-grid">
      {
        pillars.map((p) => (
          <Card>
            <div class="stack-100">
              <p class="heading-xxs text-brand">{p.eyebrow}</p>
              <h3 class="heading-m">{p.title}</h3>
              <p class="body">{p.body}</p>
            </div>
          </Card>
        ))
      }
    </div>
  </section>

  <!-- SELECTED WORK — cards now link to anchors on /work, not loop to /work index -->
  <section class="container section">
    <header class="section-head">
      <h2 class="heading-l">Selected work</h2>
      <Button href="/work" appearance="link">All work →</Button>
    </header>
    <div class="card-grid">
      {
        work.map((w) => (
          <Card href={w.href}>
            <div class="stack-100">
              <p class="heading-xxs text-brand">{w.eyebrow}</p>
              <h3 class="heading-m">{w.title}</h3>
              <p class="body">{w.body}</p>
              <div class="tag-row tag-row--tight">
                {w.tags.map((t) => (
                  <Tag text={t} color="blue" />
                ))}
              </div>
            </div>
          </Card>
        ))
      }
    </div>
  </section>

  <!-- AI TOOLS -->
  <section class="container section">
    <header class="section-head">
      <h2 class="heading-l">Practical AI tools</h2>
      <Button href="/tools" appearance="link">View tools →</Button>
    </header>
    <p class="body-l measure">
      The useful AI work is rarely flashy. It helps a team prepare for a
      handoff, read account risk, write a cleaner follow-up, or see what changed
      before the customer has to repeat it. Less drag, a clearer next action,
      better judgment.
    </p>
    <div class="card-grid card-grid--3" style="margin-top:var(--space-300)">
      {
        tools.map((t) => (
          <Card href="/tools">
            <div class="stack-100">
              <Lozenge label={t.status} appearance={t.appearance as any} />
              <h3 class="heading-s">{t.title}</h3>
            </div>
          </Card>
        ))
      }
    </div>
  </section>

  <!-- WRITING -->
  <section class="container section">
    <header class="section-head">
      <h2 class="heading-l">Writing</h2>
      <Button href="/blog" appearance="link">All writing →</Button>
    </header>
    <div class="stack">
      {
        writing.map((w) => (
          <Card href="/blog" elevation="flat">
            <div class="stack-100">
              <p class="heading-xxs text-subtlest">{w.meta}</p>
              <h3 class="heading-s">{w.title}</h3>
            </div>
          </Card>
        ))
      }
    </div>
  </section>

  <!-- CONTACT -->
  <section class="container section">
    <header class="section-head">
      <h2 class="heading-l">Let's build the system.</h2>
    </header>
    <div class="contact-cta">
      <p class="body-l measure">
        If your customer lifecycle leans more on heroic individuals than on a
        working operating layer, that's the problem I'm built for. Tell me where
        it's breaking.
      </p>
      <Button href="/contact" appearance="primary">Start a conversation</Button>
    </div>
  </section>

  <style>
    .hero {
      padding-block: clamp(var(--space-800), 12vw, 7rem);
    }
    .hero-title {
      max-width: 18ch;
    }
    .hero-lead {
      max-width: 46rem;
      color: var(--color-text-subtle);
    }
    .hero-actions {
      display: flex;
      gap: var(--space-150);
      flex-wrap: wrap;
      margin-top: var(--space-200);
    }

    .section-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-200);
      margin-bottom: var(--space-400);
      flex-wrap: wrap;
    }
    .measure {
      max-width: 46rem;
    }

    .focus-grid {
      display: grid;
      gap: var(--space-400);
    }
    @media (min-width: 48rem) {
      .focus-grid {
        grid-template-columns: 1.2fr 0.8fr;
        align-items: start;
      }
    }

    .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-100);
      align-content: flex-start;
    }
    .tag-row--tight {
      margin-top: var(--space-050);
    }

    .card-grid {
      display: grid;
      gap: var(--space-200);
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    }
    .card-grid--3 {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    }

    .contact-cta {
      display: grid;
      gap: var(--space-300);
      justify-items: start;
    }
  </style>
</BaseLayout>
