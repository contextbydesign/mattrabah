---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tag from "../components/ui/Tag.astro";

const workItems = [
  {
    title: "NeuroSync",
    subtitle: "Customer Lifecycle Systems",
    summary:
      "Clinical stakeholders need to trust a product before they use it. I built the customer success workflows—spanning onboarding, adoption, and account health—to ensure that trust was earned and measured.",
    tags: [
      "Healthtech",
      "Customer Success",
      "Adoption",
      "Implementation",
      "Account Health",
    ],
  },
  {
    title: "Shinola",
    subtitle: "Portfolio Growth & CX Operations",
    summary:
      "High-touch retail requires invisible systems to feel personal. I connected client experience, account growth, and Salesforce architecture to support a complex brand environment.",
    tags: [
      "Brand-side Retail",
      "Client Experience",
      "Portfolio Growth",
      "Operating Cadence",
      "Salesforce",
    ],
  },
  {
    title: "Context By Design",
    subtitle: "Lifecycle Diagnostics & Retention",
    summary:
      "Service businesses run on visibility. I designed onboarding and retention frameworks for teams that needed clearer operating systems to see exactly where their customers were getting stuck.",
    tags: [
      "Consulting",
      "Transformation",
      "Retention Systems",
      "Lifecycle Design",
      "CX Strategy",
    ],
  },
  {
    title: "AI Workflow Projects",
    subtitle: "Practical Tools for Customer-Facing Teams",
    summary:
      "I build targeted AI workflows to solve operational bottlenecks—like identifying handoff risk, automating QBR prep, and keeping CRM data actionable.",
    tags: [
      "AI Workflows",
      "CX Tools",
      "Change Management",
      "Customer Operations",
      "Workflow Design",
    ],
  },
];
---

<BaseLayout
  title="Work"
  description="Selected work from Matt Rabah across CX management, customer success, implementation, and lifecycle systems."
>
  <section class="hero container">
    <p class="kicker">Work</p>

    <h1 class="display">
      Making the customer lifecycle visible and intentional.
    </h1>

    <p class="lead">
      My background spans healthtech, brand-side retail, and consulting. The products change, but the core challenge doesn't: making the customer lifecycle visible, manageable, and repeatable.
    </p>
  </section>

  <section class="section container" aria-labelledby="case-studies">
    <header class="section-head">
      <h2 class="section-title" id="case-studies">Case studies</h2>
    </header>

    <ul class="work-list work-list--full">
      {
        workItems.map((entry) => (
          <li class="work-list-item">
            <div class="work-link">
              <p class="kicker">{entry.subtitle}</p>
              <h3 class="work-title">{entry.title}</h3>
              <p class="work-summary">{entry.summary}</p>
              <ul class="capabilities-tags" aria-label={`${entry.title} tags`}>
                {entry.tags.map((tag) => (
                  <li>
                    <Tag label={tag} />
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>