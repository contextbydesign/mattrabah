---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tag from "../components/ui/Tag.astro";

const pillars = [
  {
    kicker: "Lifecycle Systems",
    title: "Make the customer lifecycle easier to operate.",
    summary:
      "Onboarding, adoption, account health, renewal readiness, and executive visibility should not live in scattered notes and heroic follow-up. They need a system people can use when the account gets complicated.",
  },
  {
    kicker: "AI Workflow Design",
    title: "Use AI where it reduces drag, not judgment.",
    summary:
      "AI is useful when it helps teams prepare faster, summarize context, surface risk, and make the next action clearer. It becomes noise when it replaces ownership or adds another place to check.",
  },
  {
    kicker: "Change Management",
    title: "Turn process into behavior people repeat.",
    summary:
      "A process that only works when everyone remembers it is not a process. I focus on cadence, handoffs, CRM discipline, and documentation that survive real work.",
  },
];

const featuredWork = [
  {
    kicker: "Healthtech",
    title: "NeuroSync",
    subtitle: "Customer Lifecycle Systems",
    summary:
      "Owned customer success workflows across healthcare accounts where onboarding, adoption, account health, and renewal readiness had to hold up under clinical and operational pressure.",
    meta: "Healthtech · Customer Success · Adoption & Implementation",
  },
  {
    kicker: "Brand-side retail",
    title: "Shinola",
    subtitle: "Portfolio Growth & CX Operations",
    summary:
      "Connected high-touch client experience, Salesforce process, portfolio growth, and executive-facing account work inside a brand environment where trust was built one interaction at a time.",
    meta: "Brand-side Retail · Client Experience · Operating Cadence",
  },
  {
    kicker: "Consulting",
    title: "Context By Design",
    subtitle: "Lifecycle Diagnostics & Retention",
    summary:
      "Built customer journey, onboarding, retention, and lifecycle frameworks for service businesses that needed clearer visibility into where customers stalled, churned, or lost confidence.",
    meta: "Consulting · Transformation · Retention Systems",
  },
];

const aiTools = [
  "Handoff Risk Checker",
  "Customer Health Signal Mapper",
  "Renewal Readiness Diagnostic",
];

const writing = [
  {
    title: "AI in CX fails when it starts with tools instead of workflows.",
    meta: "AI in CX · Draft",
  },
  {
    title: "The sales-to-implementation handoff is a risk control.",
    meta: "Implementation · Draft",
  },
  {
    title: "Customer health scores fail when no one owns the next action.",
    meta: "Customer Success · Draft",
  },
];
---

<BaseLayout title="Matt Rabah">
  <section class="hero container">
    <p class="kicker">CX Management · Customer Success · Practical AI Workflows</p>

    <h1 class="display">
      Customer lifecycle systems for teams that cannot afford vague ownership.
    </h1>

    <p class="lead">
      I help customer-facing teams make onboarding, adoption, account health,
      retention, and executive visibility easier to operate. The work sits
      between CX, customer success, implementation, CRM discipline, and practical
      AI workflows.
    </p>
  </section>

  <section class="section container" aria-labelledby="pillars">
    <header class="section-head">
      <h2 class="section-title" id="pillars">What I build</h2>
    </header>

    <ul class="work-list">
      {
        pillars.map((pillar) => (
          <li class="work-list-item">
            <div class="work-link">
              <p class="kicker">{pillar.kicker}</p>
              <h3 class="work-title">{pillar.title}</h3>
              <p class="work-summary">{pillar.summary}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section section--dark container" aria-labelledby="selected-work">
    <header class="section-head">
      <h2 class="section-title" id="selected-work">Selected work</h2>
      <a href="/work" class="section-more">All work →</a>
    </header>

    <ul class="work-list">
      {
        featuredWork.map((entry) => (
          <li class="work-list-item">
            <a href="/work" class="work-link">
              <p class="kicker">{entry.kicker}</p>
              <h3 class="work-title">{entry.title}</h3>
              <p class="work-summary">
                <strong>{entry.subtitle}</strong> — {entry.summary}
              </p>
              <p class="meta">{entry.meta}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container" aria-labelledby="ai-tools">
    <header class="section-head">
      <h2 class="section-title" id="ai-tools">
        Practical AI tools for CX, CS, and implementation teams.
      </h2>
      <a href="/tools" class="section-more">View tools →</a>
    </header>

    <div class="capabilities">
      <p class="capabilities-prose">
        The useful AI work is usually not flashy. It helps a team prepare for a
        handoff, understand account risk, write a cleaner follow-up, or see what
        changed before the customer has to repeat it. That is the bar here:
        less administrative drag, clearer next action, better human judgment.
      </p>

      <ul class="capabilities-tags" aria-label="AI tool previews">
        {
          aiTools.map((tool) => (
            <li>
              <Tag label={tool} variant="accent" size="sm" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section container" aria-labelledby="writing">
    <header class="section-head">
      <h2 class="section-title" id="writing">Writing</h2>
      <a href="/blog" class="section-more">All writing →</a>
    </header>

    <ul class="writing-list">
      {
        writing.map((entry) => (
          <li class="writing-list-item">
            <a href="/blog" class="writing-link">
              <p class="meta">{entry.meta}</p>
              <h3 class="writing-title">{entry.title}</h3>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container about-snapshot" aria-labelledby="about">
    <header class="section-head">
      <h2 class="section-title" id="about">About</h2>
    </header>

    <p class="about-prose">
      I am a Detroit-based CX, customer success, and implementation professional
      with experience across healthtech, brand-side retail, and consulting.
    </p>

    <p class="about-prose">
      My work is about making the customer lifecycle less dependent on memory,
      personality, and rescue work. Clearer systems. Better handoffs. Cleaner
      operating cadence. More useful account visibility.
    </p>
  </section>
</BaseLayout>

<style>
/* ==========================================================================
   Matt Rabah Portfolio
   Transparent nav · Typeface-inspired structure · TT Commons Pro
   ========================================================================== */

:root {
  --c-paper: #ffffff;
  --c-cream: #f5f5f7;
  --c-surface: #ffffff;
  --c-ink: #111013;
  --c-ink-soft: rgba(17, 16, 19, 0.8);
  --c-mute: #6b6a6c;
  --c-faint: rgba(17, 16, 19, 0.48);
  --c-rule: rgba(17, 16, 19, 0.08);
  --c-rule-strong: rgba(17, 16, 19, 0.18);

    --ff-sans: "Inter", "Helvetica Neue", Arial, system-ui, sans-serif;
    --ff-serif: "Inter", "Helvetica Neue", Arial, system-ui, sans-serif;
  --c-accent: var(--c-rust);
  --c-accent-ink: var(--c-rust-dark);
  --c-accent-pale: rgba(253, 36, 62, 0.08);
  --c-accent-edge: rgba(253, 36, 62, 0.3);

  --c-signal: var(--c-rust);
  --c-signal-ink: var(--c-rust);
  --c-signal-pale: rgba(253, 36, 62, 0.08);
  --c-signal-edge: rgba(253, 36, 62, 0.26);

  --ff-sans:
    "tt-commons-pro", "Inter", "Helvetica Neue", Arial, system-ui, sans-serif;
  --ff-serif:
    "tt-commons-pro", "Inter", "Helvetica Neue", Arial, system-ui, sans-serif;
  --ff-mono:
    "JetBrains Mono", "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo,
    Consolas, monospace;

  --t-display: clamp(4.5rem, 10.5vw, 9rem);
  --t-h1: clamp(3rem, 6vw, 5.5rem);
  --t-h2: clamp(2.75rem, 5vw, 4.75rem);
  --t-h3: clamp(1.75rem, 2.2vw, 2.4rem);
  --t-body-lg: clamp(1.18rem, 1.5vw, 1.45rem);
  --t-body: 1.0625rem;
  --t-small: 0.925rem;
  --t-kicker: 0.75rem;

  --lh-display: 0.92;
  --lh-h: 1;
  --lh-body: 1.55;
  --lh-tight: 1.2;

  --s-xs: 0.5rem;
  --s-sm: 0.75rem;
  --s-md: 1rem;
  --s-lg: 1.5rem;
  --s-xl: 2.5rem;
  --s-2xl: 5rem;
  --s-3xl: 8rem;

  --measure-prose: 44rem;
  --measure-page: 80rem;

  --r-sm: 8px;
  --r-md: 18px;
  --r-lg: 28px;
  --r-pill: 999px;

  --hairline: 1px solid var(--c-rule);
  --focus-ring: 2px solid var(--c-rust);
  --ms-base: 180ms ease-out;
  --ms-slow: 520ms cubic-bezier(0.2, 0.7, 0.2, 1);
}

:root[data-theme="dark"] {
  --c-paper: #111013;
  --c-cream: #1d2130;
  --c-surface: #171821;
  --c-ink: #ffffff;
  --c-ink-soft: rgba(255, 255, 255, 0.78);
  --c-mute: rgba(255, 255, 255, 0.62);
  --c-faint: rgba(255, 255, 255, 0.42);
  --c-rule: rgba(255, 255, 255, 0.1);
  --c-rule-strong: rgba(255, 255, 255, 0.18);
  --c-accent-pale: rgba(253, 36, 62, 0.14);
}

/* Reset */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
  font-feature-settings: "kern", "liga", "calt";
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  background: var(--c-paper);
  color: var(--c-ink);
  font-family: var(--ff-sans);
  font-size: var(--t-body);
  font-weight: 300;
  line-height: var(--lh-body);
  letter-spacing: -0.01em;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

body.nav-open,
body.search-open {
  overflow: hidden;
}

a {
  color: inherit;
  text-decoration-color: currentColor;
  text-underline-offset: 0.22em;
  text-decoration-thickness: 1px;
  transition:
    color var(--ms-base),
    background-color var(--ms-base),
    border-color var(--ms-base),
    transform var(--ms-base);
}

a:hover {
  color: var(--c-rust);
}

:focus-visible {
  outline: var(--focus-ring);
  outline-offset: 3px;
  border-radius: var(--r-sm);
}

::selection {
  background: var(--c-rust);
  color: #ffffff;
}

h1,
h2,
h3,
h4,
p {
  margin: 0;
}

h1,
h2,
h3,
h4 {
  text-wrap: balance;
}

p {
  text-wrap: pretty;
}

ul,
ol {
  list-style: none;
  margin: 0;
  padding: 0;
}

strong {
  color: var(--c-ink);
  font-weight: 500;
}

em,
i {
  font-style: italic;
  font-weight: 300;
}

img {
  display: block;
  max-width: 100%;
  height: auto;
}

/* Layout */

.container {
  width: 100%;
  max-width: var(--measure-page);
  padding-inline: clamp(1.5rem, 5vw, 5rem);
  margin-inline: auto;
}

/* Header */

.site-header {
  position: fixed;
  top: 0;
  inset-inline: 0;
  z-index: 1000;
  border-bottom: 1px solid var(--c-rule);
  background: color-mix(in srgb, var(--c-paper) 88%, transparent);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.header-inner {
  min-height: 4.25rem;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: clamp(1rem, 3vw, 2rem);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  color: var(--c-ink);
  font-size: 1.05rem;
  font-weight: 600;
  letter-spacing: -0.03em;
  text-decoration: none;
  white-space: nowrap;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.75rem;
  height: 1.75rem;
  border-radius: 6px;
  background: var(--c-rust);
  color: #ffffff;
  font-size: 0.9rem;
  font-weight: 600;
  line-height: 1;
}

.brand-name {
  display: inline-block;
}

.site-nav {
  justify-self: center;
}

.site-nav ul {
  display: flex;
  align-items: center;
  gap: clamp(1.1rem, 2.2vw, 2rem);
  flex-wrap: wrap;
}

.site-nav a {
  color: var(--c-ink-soft);
  font-size: var(--t-small);
  font-weight: 500;
  letter-spacing: -0.01em;
  text-decoration: none;
}

.site-nav a:hover {
  color: var(--c-rust);
}

.site-nav a[href="/tools"] {
  color: var(--c-ink-soft);
}

.site-nav a[href="/tools"]::after {
  display: none;
}

/* Header actions */

.header-actions {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--s-xs);
}

.header-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  min-height: 2.2rem;
  padding: 0.45rem 0.95rem;
  border-radius: var(--r-pill);
  background: var(--c-ink);
  color: var(--c-paper);
  font-size: var(--t-small);
  font-weight: 500;
  line-height: 1;
  text-decoration: none;
  white-space: nowrap;
}

.header-cta:hover {
  background: var(--c-rust);
  color: #ffffff;
}

/* Theme toggle */

.theme-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border: 0;
  border-radius: var(--r-pill);
  background: transparent;
  color: var(--c-ink-soft);
  font-family: var(--ff-sans);
  font-size: 1rem;
  line-height: 1;
  cursor: pointer;
}

.theme-toggle:hover {
  color: var(--c-rust);
  background: var(--c-accent-pale);
}

.theme-toggle-icon {
  display: block;
  line-height: 1;
}

/* Search */

.search-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.2rem;
  padding: 0.45rem 0.85rem;
  border: 1px solid var(--c-rule);
  border-radius: var(--r-pill);
  background: color-mix(in srgb, var(--c-surface) 86%, transparent);
  color: var(--c-ink-soft);
  font-family: var(--ff-sans);
  font-size: var(--t-small);
  font-weight: 500;
  line-height: 1;
  cursor: pointer;
}

.search-toggle:hover {
  color: var(--c-rust);
  border-color: var(--c-accent-edge);
  background: var(--c-accent-pale);
}

.site-search-panel {
  border-top: 1px solid var(--c-rule);
  border-bottom: 1px solid var(--c-rule);
  background: color-mix(in srgb, var(--c-paper) 96%, transparent);
  backdrop-filter: blur(18px);
}

.site-search-panel[hidden] {
  display: none;
}

.search-inner {
  display: grid;
  gap: var(--s-lg);
  padding-block: var(--s-xl);
}

.site-search-form {
  display: grid;
  gap: var(--s-sm);
}

.search-label {
  color: var(--c-faint);
  font-size: var(--t-kicker);
  font-weight: 500;
  letter-spacing: 0.12em;
  line-height: var(--lh-tight);
  text-transform: uppercase;
}

.search-input-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: var(--s-sm);
  align-items: center;
}

.site-search-input {
  width: 100%;
  min-height: 3.5rem;
  border: 1px solid var(--c-rule-strong);
  border-radius: var(--r-md);
  background: var(--c-surface);
  color: var(--c-ink);
  font-family: var(--ff-sans);
  font-size: clamp(1.25rem, 2vw, 1.75rem);
  font-weight: 300;
  letter-spacing: -0.03em;
  padding: 0.75rem 1rem;
}

.site-search-input::placeholder {
  color: var(--c-faint);
}

.search-close {
  min-height: 3.5rem;
  border: 1px solid var(--c-rule);
  border-radius: var(--r-md);
  background: var(--c-surface);
  color: var(--c-ink-soft);
  font-family: var(--ff-sans);
  font-size: var(--t-small);
  font-weight: 500;
  padding-inline: 1rem;
  cursor: pointer;
}

.search-close:hover {
  color: var(--c-rust);
  border-color: var(--c-accent-edge);
  background: var(--c-accent-pale);
}

.search-results-wrap,
.search-results {
  display: grid;
  gap: var(--s-sm);
}

.search-help,
.search-empty {
  color: var(--c-mute);
  font-size: var(--t-body);
  font-weight: 300;
}

.search-result-item {
  border: 1px solid var(--c-rule);
  border-radius: var(--r-md);
  background: var(--c-surface);
  overflow: hidden;
}

.search-result-link {
  display: grid;
  gap: 0.25rem;
  padding: 1rem;
  color: inherit;
  text-decoration: none;
}

.search-result-link:hover {
  background: var(--c-accent-pale);
}

.search-result-type {
  color: var(--c-faint);
  font-size: var(--t-kicker);
  font-weight: 500;
  letter-spacing: 0.1em;
  line-height: var(--lh-tight);
  text-transform: uppercase;
}

.search-result-title {
  color: var(--c-ink);
  font-size: 1.2rem;
  font-weight: 600;
  line-height: var(--lh-tight);
  letter-spacing: -0.03em;
}

.search-result-description {
  color: var(--c-mute);
  font-size: var(--t-small);
  font-weight: 300;
  line-height: 1.45;
}

/* Mobile navigation button */

.nav-toggle {
  display: none;
  appearance: none;
  border: 1px solid var(--c-rule);
  background: var(--c-surface);
  color: var(--c-ink);
  width: 2.75rem;
  height: 2.75rem;
  border-radius: var(--r-sm);
  padding: 0;
  cursor: pointer;
}

.nav-toggle-line {
  display: block;
  width: 1.15rem;
  height: 2px;
  margin: 0.25rem auto;
  background: currentColor;
  border-radius: 999px;
}

.nav-toggle[aria-expanded="true"] .nav-toggle-line:nth-child(1) {
  transform: translateY(6px) rotate(45deg);
}

.nav-toggle[aria-expanded="true"] .nav-toggle-line:nth-child(2) {
  opacity: 0;
}

.nav-toggle[aria-expanded="true"] .nav-toggle-line:nth-child(3) {
  transform: translateY(-6px) rotate(-45deg);
}

/* Page rhythm */

main {
  padding-top: 4.25rem;
}

/* Hero */

.hero {
  min-height: calc(100vh - 4.25rem);
  padding-block: clamp(5rem, 11vw, 9rem);
  display: grid;
  align-content: center;
  gap: var(--s-lg);
  position: relative;
  background: var(--c-cream);
}

.hero::after {
  content: "";
  display: block;
  width: min(100%, 32rem);
  height: 3px;
  margin-top: var(--s-md);
  background: linear-gradient(
    90deg,
    var(--c-rust) 0%,
    rgba(253, 36, 62, 0.36) 45%,
    transparent 100%
  );
}

.kicker {
  color: var(--c-mute);
  font-size: var(--t-kicker);
  font-weight: 500;
  line-height: var(--lh-tight);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.display {
  max-width: 14ch;
  color: var(--c-ink);
  font-size: var(--t-display);
  font-weight: 600;
  line-height: var(--lh-display);
  letter-spacing: -0.055em;
}

.display em,
.display strong {
  color: var(--c-rust);
  font-style: normal;
  font-weight: inherit;
}

.lead {
  max-width: var(--measure-prose);
  color: var(--c-ink-soft);
  font-size: var(--t-body-lg);
  font-weight: 300;
  line-height: var(--lh-body);
}

/* Sections */

.section {
  padding-block: clamp(5rem, 10vw, 9rem);
  border-top: var(--hairline);
  background: var(--c-paper);
}

.section:nth-of-type(even) {
  background: var(--c-cream);
}

.section-head {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: var(--s-md);
  margin-bottom: var(--s-xl);
}

.section-title {
  max-width: 12ch;
  color: var(--c-ink);
  font-size: var(--t-h2);
  font-weight: 600;
  line-height: var(--lh-h);
  letter-spacing: -0.045em;
}

.section-more {
  color: var(--c-rust);
  font-size: var(--t-small);
  font-weight: 500;
  text-decoration: none;
}

/* Cards */

.work-list,
.writing-list {
  display: grid;
  gap: var(--s-md);
}

.work-list {
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
}

.work-list--full {
  grid-template-columns: 1fr;
}

.work-list-item,
.writing-list-item {
  border: 1px solid var(--c-rule);
  background: var(--c-surface);
  border-radius: var(--r-md);
  overflow: hidden;
  transition:
    transform var(--ms-slow),
    box-shadow var(--ms-slow),
    border-color var(--ms-base);
}

.work-list-item:hover,
.writing-list-item:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.08);
  border-color: var(--c-rule-strong);
}

.work-link,
.writing-link {
  display: grid;
  gap: var(--s-sm);
  padding: clamp(1.5rem, 3vw, 2.5rem);
  color: inherit;
  text-decoration: none;
}

.work-title,
.writing-title {
  max-width: 34ch;
  color: var(--c-ink);
  font-size: clamp(1.8rem, 2.4vw, 3rem);
  font-weight: 600;
  line-height: 1.03;
  letter-spacing: -0.04em;
}

.work-link:hover .work-title,
.writing-link:hover .writing-title {
  color: var(--c-rust);
}

.work-summary,
.writing-dek {
  max-width: var(--measure-prose);
