---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import Lozenge from "../components/lozenge.astro";
import Stat from "../components/stat.astro";
import Tag from "../components/ui/Tag.astro";

const work = [
  {
    index: "01",
    href: "/work#neurosync",
    kicker: "Healthtech",
    title: "NeuroSync",
    line: "Stood up customer success from scratch for a clinical platform — onboarding, adoption tracking, and a renewal motion that held up under real operational pressure.",
    tags: ["Customer success", "Implementation", "Healthcare"],
  },
  {
    index: "02",
    href: "/work#shinola",
    kicker: "Brand-side retail",
    title: "Shinola",
    line: "Ran a corporate account portfolio at the Detroit flagship — high-touch client experience, Salesforce process, and executive relationships, kept personal at scale.",
    tags: ["Portfolio growth", "Salesforce", "Client experience"],
  },
  {
    index: "03",
    href: "/work#context-by-design",
    kicker: "Consulting",
    title: "Context By Design",
    line: "Built lifecycle and retention frameworks for service businesses that had relationships but no system — so they could finally see where customers stalled.",
    tags: ["Lifecycle design", "Retention", "CX strategy"],
  },
];

const tools = [
  { title: "Handoff Risk Checker", status: "progress", label: "Prototype" },
  {
    title: "Customer Health Signal Mapper",
    status: "progress",
    label: "Prototype",
  },
  {
    title: "Renewal Readiness Diagnostic",
    status: "planned",
    label: "Planned",
  },
];

const writing = [
  {
    meta: "AI in CX",
    title: "AI in CX fails when it starts with tools instead of workflows.",
  },
  {
    meta: "Implementation",
    title: "The sales-to-implementation handoff is a risk control.",
  },
  {
    meta: "Customer success",
    title: "Health scores fail when no one owns the next action.",
  },
];
---

<BaseLayout title="Matt Rabah">
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow reveal reveal-1">
        Customer Experience · Customer Success
      </p>
      <h1 class="display reveal reveal-2">
        I make customers <em>easier to keep.</em>
      </h1>
      <p class="lead hero-lead reveal reveal-3">
        I'm a CX and customer success professional in Detroit. I build the
        operating layer underneath customer-facing teams — the onboarding,
        handoffs, account health, and renewal rhythm that decide whether people
        stay. Lately, that includes practical AI where it actually saves the
        team time.
      </p>
      <div class="hero-actions reveal reveal-4">
        <Button href="/work" variant="solid" arrow>See the work</Button>
        <Button href="/contact" variant="ghost">Start a conversation</Button>
      </div>
    </div>
  </section>

  <!-- POSITIONING + STATS -->
  <section class="section section--alt">
    <div class="container">
      <div class="intro-grid">
        <p class="lead">
          Most customer experience problems aren't really about the customer.
          They're about the system behind them — a vague owner, a note that
          never got written down, a handoff that dropped context. Fix the
          operating model and the experience fixes itself.
        </p>
        <div class="stat-row">
          <Stat value="7+" label="Years in CX & CS" />
          <Stat
            value="3"
            label="Industries"
            note="Healthtech · Retail · Consulting"
          />
          <Stat value="M.S." label="CX Management" note="Michigan State" />
        </div>
      </div>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2 class="h2">Proof across messy customer systems.</h2>
        </div>
        <Button href="/work" variant="link" arrow>All work</Button>
      </div>
      <div class="work-list">
        {
          work.map((w) => (
            <Card href={w.href} index={w.index}>
              <p class="meta" style="color:var(--color-text-accent)">
                {w.kicker}
              </p>
              <h3 class="h3" style="margin-top:var(--space-2)">
                {w.title}
              </h3>
              <p class="body" style="margin-top:var(--space-3); max-width:46ch">
                {w.line}
              </p>
              <div class="chip-row">
                {w.tags.map((t) => (
                  <Tag text={t} />
                ))}
              </div>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <!-- AI TOOLS -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Practical AI</p>
          <h2 class="h2">Small tools for the gaps that cost you accounts.</h2>
        </div>
        <Button href="/tools" variant="link" arrow>View tools</Button>
      </div>
      <p class="body" style="max-width:52ch; margin-bottom:var(--space-6)">
        None of this is flashy. It helps a team prep for a handoff, read account
        risk early, or write a follow-up that doesn't make the customer repeat
        themselves. That's the whole bar.
      </p>
      <div class="tool-row">
        {
          tools.map((t) => (
            <Card href="/tools" flat>
              <Lozenge label={t.label} status={t.status as any} />
              <h3 class="h4" style="margin-top:var(--space-3)">
                {t.title}
              </h3>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WRITING -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Writing</p>
          <h2 class="h2">Notes on better customer systems.</h2>
        </div>
        <Button href="/blog" variant="link" arrow>All writing</Button>
      </div>
      <div class="writing-list">
        {
          writing.map((w, idx) => (
            <a href="/blog" class="writing-row">
              <span class="meta writing-idx">
                {String(idx + 1).padStart(2, "0")}
              </span>
              <span class="writing-text">
                <span class="meta" style="color:var(--color-text-accent)">
                  {w.meta}
                </span>
                <span class="h3 writing-title">{w.title}</span>
              </span>
              <span class="writing-arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section section--alt">
    <div class="container contact-band">
      <p class="eyebrow eyebrow--plain">Let's talk</p>
      <h2 class="display contact-title">
        If your lifecycle runs on heroics, that's the problem I fix.
      </h2>
      <div class="hero-actions">
        <Button href="/contact" variant="accent" arrow
          >Start a conversation</Button
        >
        <Button href="/about" variant="ghost">More about me</Button>
      </div>
    </div>
  </section>

  <style>
    .hero {
      padding-block: clamp(var(--space-9), 16vw, 11rem) var(--space-9);
    }
    .hero .display {
      max-width: 16ch;
      margin-top: var(--space-5);
    }
    .hero-lead {
      max-width: 52ch;
      margin-top: var(--space-6);
    }
    .hero-actions {
      display: flex;
      gap: var(--space-3);
      flex-wrap: wrap;
      margin-top: var(--space-7);
    }

    .intro-grid {
      display: grid;
      gap: var(--space-7);
    }
    @media (min-width: 52rem) {
      .intro-grid {
        grid-template-columns: 1.1fr 0.9fr;
        gap: var(--space-9);
        align-items: center;
      }
    }
    .stat-row {
      display: grid;
      grid-template-columns: repeat(3, auto);
      gap: var(--space-6);
      justify-content: start;
    }
    @media (max-width: 30rem) {
      .stat-row {
        grid-template-columns: 1fr 1fr;
      }
    }

    .work-list {
      display: grid;
      gap: var(--space-4);
    }
    @media (min-width: 52rem) {
      .work-list {
        grid-template-columns: 1fr 1fr;
      }
    }
    .chip-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: var(--space-5);
    }

    .tool-row {
      display: grid;
      gap: var(--space-4);
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    }

    .writing-list {
      display: grid;
    }
    .writing-row {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: var(--space-5);
      padding: var(--space-5) 0;
      border-top: 1px solid var(--color-border);
      color: inherit;
      text-decoration: none;
      transition: padding var(--dur-2) var(--ease);
    }
    .writing-row:last-child {
      border-bottom: 1px solid var(--color-border);
    }
    .writing-row:hover {
      padding-inline: var(--space-3);
    }
    .writing-idx {
      color: var(--color-text-faint);
    }
    .writing-text {
      display: grid;
      gap: var(--space-2);
    }
    .writing-title {
      color: var(--color-text);
      transition: color var(--dur-1) var(--ease);
      max-width: 40ch;
    }
    .writing-row:hover .writing-title {
      color: var(--color-text-accent);
    }
    .writing-arrow {
      color: var(--color-text-faint);
      transition:
        transform var(--dur-1) var(--ease),
        color var(--dur-1) var(--ease);
    }
    .writing-row:hover .writing-arrow {
      color: var(--color-text-accent);
      transform: translateX(4px);
    }

    .contact-band {
      text-align: center;
      display: grid;
      justify-items: center;
      gap: var(--space-6);
    }
    .contact-title {
      max-width: 20ch;
    }
    .contact-band .hero-actions {
      justify-content: center;
    }
  </style>
</BaseLayout>
