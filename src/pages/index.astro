---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tag from "../components/ui/Tag.astro";

const pillars = [
  {
    kicker: "Lifecycle Systems",
    title: "Make the customer lifecycle easier to operate.",
    summary:
      "Onboarding, adoption, account health, renewal readiness, and executive visibility should not live in scattered notes and heroic follow-up. They need a system people can use when the account gets complicated.",
  },
  {
    kicker: "AI Workflow Design",
    title: "Use AI where it reduces drag, not judgment.",
    summary:
      "AI is useful when it helps teams prepare faster, summarize context, surface risk, and make the next action clearer. It becomes noise when it replaces ownership or adds another place to check.",
  },
  {
    kicker: "Change Management",
    title: "Turn process into behavior people repeat.",
    summary:
      "A process that only works when everyone remembers it is not a process. I focus on cadence, handoffs, CRM discipline, and documentation that survive real work.",
  },
];

const featuredWork = [
  {
    kicker: "Healthtech",
    title: "NeuroSync",
    subtitle: "Customer Lifecycle Systems",
    summary:
      "Owned customer success workflows across healthcare accounts where onboarding, adoption, account health, and renewal readiness had to hold up under clinical and operational pressure.",
    meta: "Healthtech · Customer Success · Adoption & Implementation",
  },
  {
    kicker: "Brand-side retail",
    title: "Shinola",
    subtitle: "Portfolio Growth & CX Operations",
    summary:
      "Connected high-touch client experience, Salesforce process, portfolio growth, and executive-facing account work inside a brand environment where trust was built one interaction at a time.",
    meta: "Brand-side Retail · Client Experience · Operating Cadence",
  },
  {
    kicker: "Consulting",
    title: "Context By Design",
    subtitle: "Lifecycle Diagnostics & Retention",
    summary:
      "Built customer journey, onboarding, retention, and lifecycle frameworks for service businesses that needed clearer visibility into where customers stalled, churned, or lost confidence.",
    meta: "Consulting · Transformation · Retention Systems",
  },
];

const aiTools = [
  "Handoff Risk Checker",
  "Customer Health Signal Mapper",
  "Renewal Readiness Diagnostic",
];

const writing = [
  {
    title: "AI in CX fails when it starts with tools instead of workflows.",
    meta: "AI in CX · Draft",
  },
  {
    title: "The sales-to-implementation handoff is a risk control.",
    meta: "Implementation · Draft",
  },
  {
    title: "Customer health scores fail when no one owns the next action.",
    meta: "Customer Success · Draft",
  },
];
---

<BaseLayout
  title="Matt Rabah"
  description="Matt Rabah builds customer lifecycle systems, practical AI workflows, and operating models for customer-facing teams."
>
  <section class="hero container">
    <p class="kicker">CX systems · AI workflows</p>

    <h1 class="display">Systems that make customers easier to keep.</h1>

    <p class="lead">
      I build customer lifecycle systems, practical AI workflows, and operating
      rhythms for teams that need clearer ownership.
    </p>
  </section>

  <section class="section container" aria-labelledby="home-intro">
    <header class="section-head">
      <h2 class="section-title" id="home-intro">
        The homepage is the front door.
      </h2>
    </header>

    <div class="capabilities">
      <p class="capabilities-prose">
        This site is organized around the work I want to be known for: customer
        lifecycle systems, implementation discipline, account visibility,
        retention readiness, and practical AI workflows that reduce operational
        drag without replacing human judgment.
      </p>

      <ul class="capabilities-tags" aria-label="Homepage focus areas">
        <li><Tag label="Lifecycle systems" /></li>
        <li><Tag label="Implementation" /></li>
        <li><Tag label="Customer success" /></li>
        <li><Tag label="AI workflows" /></li>
        <li><Tag label="CRM discipline" /></li>
      </ul>
    </div>
  </section>

  <section class="section container" aria-labelledby="pillars">
    <header class="section-head">
      <h2 class="section-title" id="pillars">What I build</h2>
    </header>

    <ul class="work-list">
      {
        pillars.map((pillar) => (
          <li class="work-list-item">
            <div class="work-link">
              <p class="kicker">{pillar.kicker}</p>
              <h3 class="work-title">{pillar.title}</h3>
              <p class="work-summary">{pillar.summary}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    class="section section--dark container"
    aria-labelledby="selected-work"
  >
    <header class="section-head">
      <h2 class="section-title" id="selected-work">Selected work</h2>
      <a href="/work" class="section-more">All work →</a>
    </header>

    <ul class="work-list">
      {
        featuredWork.map((entry) => (
          <li class="work-list-item">
            <a href="/work" class="work-link">
              <p class="kicker">{entry.kicker}</p>
              <h3 class="work-title">{entry.title}</h3>
              <p class="work-summary">
                <strong>{entry.subtitle}</strong> — {entry.summary}
              </p>
              <p class="meta">{entry.meta}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container" aria-labelledby="ai-tools">
    <header class="section-head">
      <h2 class="section-title" id="ai-tools">
        Practical AI tools for CX, CS, and implementation teams.
      </h2>
      <a href="/tools" class="section-more">View tools →</a>
    </header>

    <div class="capabilities">
      <p class="capabilities-prose">
        The useful AI work is usually not flashy. It helps a team prepare for a
        handoff, understand account risk, write a cleaner follow-up, or see what
        changed before the customer has to repeat it. That is the bar here: less
        administrative drag, clearer next action, better human judgment.
      </p>

      <ul class="capabilities-tags" aria-label="AI tool previews">
        {
          aiTools.map((tool) => (
            <li>
              <Tag label={tool} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section container" aria-labelledby="writing">
    <header class="section-head">
      <h2 class="section-title" id="writing">Writing</h2>
      <a href="/blog" class="section-more">All writing →</a>
    </header>

    <ul class="writing-list">
      {
        writing.map((entry) => (
          <li class="writing-list-item">
            <a href="/blog" class="writing-link">
              <p class="meta">{entry.meta}</p>
              <h3 class="writing-title">{entry.title}</h3>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container about-snapshot" aria-labelledby="about">
    <header class="section-head">
      <h2 class="section-title" id="about">About</h2>
      <a href="/about" class="section-more">More about me →</a>
    </header>

    <p class="about-prose">
      I am a Detroit-based CX, customer success, and implementation professional
      with experience across healthtech, brand-side retail, and consulting.
    </p>

    <p class="about-prose">
      My work is about making the customer lifecycle less dependent on memory,
      personality, and rescue work. Clearer systems. Better handoffs. Cleaner
      operating cadence. More useful account visibility.
    </p>
  </section>

  <section class="section container" aria-labelledby="contact">
    <header class="section-head">
      <h2 class="section-title" id="contact">Let's build the system.</h2>
      <a href="/contact" class="section-more">Contact →</a>
    </header>

    <p class="about-prose">
      If your customer lifecycle depends more on heroic individuals than on a
      working operating layer, we should talk.
    </p>
  </section>
</BaseLayout>
