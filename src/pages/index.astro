---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import Lozenge from "../components/lozenge.astro";
import Tag from "../components/ui/Tag.astro";

const pillars = [
  {
    kicker: "Lifecycle",
    title: "Make progress visible.",
    body: "Onboarding, adoption, account health, and renewal readiness, in one operating model the team can actually run when the account gets complicated.",
  },
  {
    kicker: "Practical AI",
    title: "Reduce drag, not judgment.",
    body: "AI that helps a team prepare faster, summarize context, and surface risk earlier — never another place to check, never a way to blur who owns what.",
  },
  {
    kicker: "Change",
    title: "Make process stick.",
    body: "Cadence, handoffs, and CRM discipline that hold up under real workload — not a process that only works when everyone remembers it.",
  },
];

const work = [
  {
    index: "01",
    href: "/work#neurosync",
    kicker: "Healthtech",
    title: "NeuroSync",
    line: "Stood up customer success from scratch for a clinical platform — onboarding, adoption, and a renewal motion that held under real operational pressure.",
    tags: ["Customer success", "Implementation"],
  },
  {
    index: "02",
    href: "/work#shinola",
    kicker: "Brand-side retail",
    title: "Shinola",
    line: "Ran a corporate account portfolio at the Detroit flagship — high-touch client experience and Salesforce process, kept personal at scale.",
    tags: ["Portfolio growth", "Salesforce"],
  },
  {
    index: "03",
    href: "/work#context-by-design",
    kicker: "Consulting",
    title: "Context By Design",
    line: "Built lifecycle and retention frameworks for service businesses that had relationships but no system to see where customers stalled.",
    tags: ["Lifecycle design", "Retention"],
  },
];

const tools = [
  { title: "Handoff Risk Checker", status: "progress", label: "Prototype" },
  {
    title: "Customer Health Signal Mapper",
    status: "progress",
    label: "Prototype",
  },
  {
    title: "Renewal Readiness Diagnostic",
    status: "planned",
    label: "Planned",
  },
];

const writing = [
  {
    meta: "AI in CX",
    title: "AI in CX fails when it starts with tools instead of workflows.",
  },
  {
    meta: "Implementation",
    title: "The sales-to-implementation handoff is a risk control.",
  },
  {
    meta: "Customer success",
    title: "Health scores fail when no one owns the next action.",
  },
];
---

<BaseLayout title="Matt Rabah">
  <section class="hero">
    <div class="container">
      <p class="eyebrow reveal reveal-1">
        Customer Experience · Customer Success
      </p>
      <h1 class="display reveal reveal-2">
        I make customers <em>easier to keep.</em>
      </h1>
      <p class="lead hero-lead reveal reveal-3">
        A CX and customer success professional in Detroit, building the
        operating layer underneath customer-facing teams — the onboarding,
        handoffs, account health, and renewal rhythm that decide whether people
        stay.
      </p>
      <div class="hero-actions reveal reveal-4">
        <Button href="/work" variant="solid" arrow>See the work</Button>
        <Button href="/contact" variant="ghost">Start a conversation</Button>
      </div>
    </div>
  </section>

  <section class="statement section--alt">
    <div class="container statement-inner">
      <h2 class="statement-title">
        Customer experience is <em>made or lost</em> in the operating model.
      </h2>
      <p class="statement-sub">
        Not in the brand, not in the dashboard. In who owns the next action,
        what survives a handoff, and whether the team can see where the customer
        actually is.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">What I build</p><h2 class="h2">
            Three places the lifecycle breaks — and holds.
          </h2>
        </div>
      </div>
      <div class="pillars">
        {
          pillars.map((p) => (
            <article class="pillar">
              <p class="pillar-kicker">{p.kicker}</p>
              <h3 class="pillar-title">{p.title}</h3>
              <p class="pillar-body">{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Selected work</p><h2 class="h2">
            Proof across messy customer systems.
          </h2>
        </div>
        <Button href="/work" variant="link" arrow>All work</Button>
      </div>
      <div class="work-list">
        {
          work.map((w) => (
            <Card href={w.href} index={w.index}>
              <p class="meta" style="color:var(--color-text-accent)">
                {w.kicker}
              </p>
              <h3 class="h3" style="margin-top:var(--space-2)">
                {w.title}
              </h3>
              <p class="body" style="margin-top:var(--space-3); max-width:46ch">
                {w.line}
              </p>
              <div class="chip-row">
                {w.tags.map((t) => (
                  <Tag text={t} />
                ))}
              </div>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section class="quote-band">
    <div class="container">
      <blockquote class="quote">
        <span class="quote-mark">&ldquo;</span>A weak handoff turns a closed
        deal into implementation risk. The record should help the next person,
        before the customer has to repeat themselves.<span class="quote-mark"
          >&rdquo;</span
        >
        <cite class="quote-cite">Operating principle no. 02</cite>
      </blockquote>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Practical AI</p><h2 class="h2">
            Small tools for the gaps that cost you accounts.
          </h2>
        </div>
        <Button href="/tools" variant="link" arrow>View tools</Button>
      </div>
      <div class="tool-row">
        {
          tools.map((t) => (
            <Card href="/tools" flat>
              <Lozenge label={t.label} status={t.status as any} />
              <h3 class="h4" style="margin-top:var(--space-3)">
                {t.title}
              </h3>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Writing</p><h2 class="h2">
            Notes on better customer systems.
          </h2>
        </div>
        <Button href="/blog" variant="link" arrow>All writing</Button>
      </div>
      <div class="writing-list">
        {
          writing.map((w, idx) => (
            <a href="/blog" class="writing-row">
              <span class="meta writing-idx">
                {String(idx + 1).padStart(2, "0")}
              </span>
              <span class="writing-text">
                <span class="meta" style="color:var(--color-text-accent)">
                  {w.meta}
                </span>
                <span class="h3 writing-title">{w.title}</span>
              </span>
              <span class="writing-arrow" aria-hidden="true">
                &rarr;
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="statement section--alt">
    <div class="container statement-inner">
      <p class="eyebrow eyebrow--plain">Let's talk</p>
      <h2 class="statement-title">
        If your lifecycle runs on <em>heroics,</em> that's the problem I fix.
      </h2>
      <div class="hero-actions" style="justify-content:center">
        <Button href="/contact" variant="accent" arrow
          >Start a conversation</Button
        >
        <Button href="/about" variant="ghost">More about me</Button>
      </div>
    </div>
  </section>

  <style>
    .hero {
      padding-block: clamp(var(--space-10), 18vw, 12rem) var(--space-9);
    }
    .hero .display {
      max-width: 15ch;
      margin-top: var(--space-5);
    }
    .hero-lead {
      max-width: 50ch;
      margin-top: var(--space-6);
    }
    .hero-actions {
      display: flex;
      gap: var(--space-3);
      flex-wrap: wrap;
      margin-top: var(--space-7);
    }
    .work-list {
      display: grid;
      gap: var(--space-4);
    }
    @media (min-width: 52rem) {
      .work-list {
        grid-template-columns: 1fr 1fr;
      }
    }
    .chip-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: var(--space-5);
    }
    .tool-row {
      display: grid;
      gap: var(--space-4);
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    }
    .writing-list {
      display: grid;
    }
    .writing-row {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: var(--space-5);
      padding: var(--space-5) 0;
      border-top: 1px solid var(--color-border);
      color: inherit;
      text-decoration: none;
      transition: padding var(--dur-2) var(--ease);
    }
    .writing-row:last-child {
      border-bottom: 1px solid var(--color-border);
    }
    .writing-row:hover {
      padding-inline: var(--space-3);
    }
    .writing-idx {
      color: var(--color-text-faint);
    }
    .writing-text {
      display: grid;
      gap: var(--space-2);
    }
    .writing-title {
      color: var(--color-text);
      transition: color var(--dur-1) var(--ease);
      max-width: 40ch;
    }
    .writing-row:hover .writing-title {
      color: var(--color-text-accent);
    }
    .writing-arrow {
      color: var(--color-text-faint);
      transition:
        transform var(--dur-1) var(--ease),
        color var(--dur-1) var(--ease);
    }
    .writing-row:hover .writing-arrow {
      color: var(--color-text-accent);
      transform: translateX(4px);
    }
  </style>
</BaseLayout>
