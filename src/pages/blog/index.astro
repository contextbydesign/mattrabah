---
import BaseLayout from "../../layouts/BaseLayout.astro";

const blogPosts = [
  {
    title: "The problem with 'spray and pray' operations",
    date: "2026-05-18",
    dek: "Why high-volume tactical fixes usually fail, and how to build a strategic operating cadence instead.",
    url: "/blog/spray-and-pray",
  },
  {
    title: "Diagnosing input blindness in your CRM",
    date: "2026-04-02",
    dek: "When your team is entering data just to satisfy a required field, you don't have a system. You have a chore.",
    url: "/blog/input-blindness",
  },
  {
    title: "Salesforce as plumbing, not strategy",
    date: "2026-02-14",
    dek: "A certification is just permission to touch the pipes. The real work is figuring out where the water needs to go.",
    url: "/blog/salesforce-plumbing",
  },
];
---

<BaseLayout
  title="Writing"
  description="Thoughts on customer operations, system design, and building things that actually work."
>
  <section class="hero container">
    <p class="kicker">Writing</p>

    <h1 class="display">Field notes on systems and strategy.</h1>

    <p class="lead">
      Observations on AI-enabled CX management, CRM discipline, and the operating models behind better customer outcomes.
    </p>
  </section>

  <section class="section container" aria-labelledby="articles">
    <header class="section-head">
      <h2 class="section-title" id="articles">Recent notes</h2>
    </header>

    <ul class="writing-list">
      {
        blogPosts.map((post) => (
          <li class="writing-list-item">
            <a href={post.url} class="writing-link">
              <time class="meta" datetime={post.date}>
                {new Date(post.date).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
              <h3 class="writing-title">{post.title}</h3>
              <p class="writing-dek">{post.dek}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>