---
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = [
  {
    meta: "AI in CX · Draft",
    title: "AI in CX fails when it starts with tools instead of workflows.",
    dek: "A practical argument for starting with customer-facing operating problems before adding AI to the stack.",
  },
  {
    meta: "Implementation · Draft",
    title: "The sales-to-implementation handoff is a risk control.",
    dek: "Why delivery risk often starts before the implementation owner ever meets the customer.",
  },
  {
    meta: "Customer Success · Draft",
    title: "Customer health scores fail when no one owns the next action.",
    dek: "A customer health system is only useful if it changes behavior, accountability, and follow-through.",
  },
  {
    meta: "Change Management · Draft",
    title: "AI adoption is a change-management problem before it is a tooling problem.",
    dek: "The hard part is rarely access to tools. It is workflow fit, trust, governance, and repeatable team behavior.",
  },
];
---

<BaseLayout
  title="Writing"
  description="Writing from Matt Rabah on AI-enabled CX management, customer lifecycle systems, implementation, account health, CRM discipline, and change management."
>
  <section class="hero container">
    <p class="kicker">Writing</p>

    <h1 class="display">
      Notes on AI-enabled CX management and customer lifecycle systems.
    </h1>

    <p class="lead">
      Writing on practical AI workflows, customer success, implementation,
      account health, CRM discipline, change management, and the operating
      systems behind better customer outcomes.
    </p>
  </section>

  <section class="section container" aria-labelledby="posts">
    <header class="section-head">
      <h2 class="section-title" id="posts">Recent notes</h2>
    </header>

    <ul class="writing-list writing-list--full">
      {
        posts.map((entry) => (
          <li class="writing-list-item">
            <a href="/blog" class="writing-link">
              <p class="meta">{entry.meta}</p>
              <h3 class="writing-title">{entry.title}</h3>
              <p class="writing-dek">{entry.dek}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>