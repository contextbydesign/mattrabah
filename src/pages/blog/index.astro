---
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = [
  {
    href: "/blog/customer-handoffs",
    date: "May 2026",
    category: "Customer Success",
    title: "Customer handoffs fail before anyone notices",
    description:
      "A practical note on why lifecycle ownership breaks, what to document, and how to make the next action visible before the account stalls.",
  },
  {
    href: "/blog/account-health",
    date: "May 2026",
    category: "Operating Systems",
    title: "Account health is not a color",
    description:
      "Red, yellow, and green only help when the team knows what changed, who owns the next move, and what evidence would change the status.",
  },
];
---

<BaseLayout
  title="Writing"
  description="Notes on customer success, implementation, AI workflows, and the operating details that decide whether customers stay."
>
  <section class="blog-index">
    <div class="container">
      <header class="blog-index-hero">
        <p class="eyebrow">Writing</p>
        <h1 class="h1">Notes on customer systems.</h1>
        <p class="lead">
          Short essays on customer success, implementation, AI workflows, and
          the operating details that decide whether customers stay.
        </p>
      </header>

      <div class="blog-list" aria-label="Blog posts">
        {
          posts.map((post) => (
            <article class="blog-list-item">
              <a class="blog-list-link" href={post.href}>
                <p class="blog-list-date">
                  {post.category}
                  <br />
                  {post.date}
                </p>

                <h2 class="blog-list-title">{post.title}</h2>

                <p class="blog-list-dek">{post.description}</p>

                <span class="blog-list-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
