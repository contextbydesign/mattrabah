---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import Lozenge from "../../components/Lozenge.astro";

const posts = [
  {
    meta: "AI in CX",
    title: "AI in CX fails when it starts with tools instead of workflows.",
    dek: "Most teams don't need another AI demo. They need a clearer view of the customer-facing work that's slow, repetitive, risky, or easy to drop.",
  },
  {
    meta: "Implementation",
    title: "The sales-to-implementation handoff is a risk control.",
    dek: "A closed deal can still become a delivery problem. The handoff is where context, constraints, and ownership either line up or start leaking trust.",
  },
  {
    meta: "Customer success",
    title: "Customer health scores fail when no one owns the next action.",
    dek: "A score is only useful if it changes behavior. Otherwise it's a cleaner way to watch risk arrive late.",
  },
  {
    meta: "Change management",
    title:
      "AI adoption is a change-management problem before it's a tooling problem.",
    dek: "The hard part is rarely access. It's workflow fit, trust, governance, and knowing when to use the tool and when not to.",
  },
];
---

<BaseLayout
  title="Writing"
  description="Writing from Matt Rabah on practical AI workflows, customer lifecycle systems, implementation, account health, and CRM discipline."
>
  <section class="container section hero">
    <div class="stack-300">
      <p class="heading-xxs text-brand">Writing</p>
      <h1 class="heading-xxl" style="max-width:16ch">
        Notes on better customer systems.
      </h1>
      <p class="body-l measure">
        Short essays on customer success, implementation, AI workflows, and the
        operating details that decide whether customers stay.
      </p>
    </div>
  </section>

  <section class="container section">
    <header class="section-head">
      <h2 class="heading-l">Recent notes</h2>
    </header>
    <div class="stack">
      {
        posts.map((p) => (
          <Card href="/blog" elevation="flat">
            <div class="stack-100">
              <div class="post-meta">
                <span class="heading-xxs text-subtlest">{p.meta}</span>
                <Lozenge label="Draft" appearance="moved" />
              </div>
              <h2 class="heading-m">{p.title}</h2>
              <p class="body">{p.dek}</p>
            </div>
          </Card>
        ))
      }
    </div>
  </section>

  <style>
    .hero {
      padding-block: clamp(var(--space-800), 12vw, 7rem);
    }
    .measure {
      max-width: 46rem;
      color: var(--color-text-subtle);
    }
    .section-head {
      margin-bottom: var(--space-300);
    }
    .post-meta {
      display: flex;
      align-items: center;
      gap: var(--space-150);
    }
  </style>
</BaseLayout>
