---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
  title="Writing"
  description="Notes on customer success, implementation, AI workflows, and the operating details that decide whether customers stay."
>
  <section class="blog-index">
    <div class="container">
      <header class="blog-index-hero">
        <p class="eyebrow">Writing</p>
        <h1 class="h1">Notes on customer systems.</h1>
        <p class="lead">
          Short essays and practical checklists for teams that run customer
          lifecycles — implementation, adoption, and the small signals that
          matter.
        </p>
      </header>

      <div class="blog-list" aria-label="Blog posts">
        {
          posts.map((post) => (
            <article class="blog-list-item">
              <a class="blog-list-link" href={`/blog/${post.id}`}>
                <p class="blog-list-date">
                  {post.data.category}
                  <br />
                  {post.data.date.toLocaleDateString("en-US", {
                    month: "short",
                    year: "numeric",
                  })}
                </p>

                <h2 class="blog-list-title">{post.data.title}</h2>

                <p class="blog-list-dek">{post.data.description}</p>

                <span class="blog-list-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
