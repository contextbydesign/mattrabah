---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/ui/Tag.astro";

const workItems = [
  {
    title: "NeuroSync",
    subtitle: "Customer Lifecycle Systems",
    summary:
      "Built and managed customer success workflows across healthcare accounts, with ownership across onboarding, adoption, account health, clinical stakeholder communication, and renewal readiness.",
    tags: [
      "Healthtech",
      "Customer Success",
      "Adoption",
      "Implementation",
      "Account Health",
    ],
  },
  {
    title: "Shinola",
    subtitle: "Portfolio Growth & CX Operations",
    summary:
      "Connected high-touch customer experience, account growth, Salesforce process, executive event execution, and portfolio discipline inside a complex brand-side retail environment.",
    tags: [
      "Brand-side Retail",
      "Client Experience",
      "Portfolio Growth",
      "Operating Cadence",
      "Salesforce",
    ],
  },
  {
    title: "Context By Design",
    subtitle: "Lifecycle Diagnostics & Retention",
    summary:
      "Designed lifecycle, onboarding, customer journey, and retention frameworks for service businesses that needed clearer operating systems and better customer visibility.",
    tags: [
      "Consulting",
      "Transformation",
      "Retention Systems",
      "Lifecycle Design",
      "CX Strategy",
    ],
  },
  {
    title: "AI Workflow Projects",
    subtitle: "Practical Tools for Customer-Facing Teams",
    summary:
      "Building lightweight AI-assisted tools for handoff risk, account health, renewal readiness, QBR preparation, and CRM field quality.",
    tags: [
      "AI Workflows",
      "CX Tools",
      "Change Management",
      "Customer Operations",
      "Workflow Design",
    ],
  },
];
---

<BaseLayout
  title="Work"
  description="Selected work from Matt Rabah across CX management, customer success, implementation, AI workflow design, and lifecycle systems."
>
  <section class="hero container">
    <p class="kicker">Work</p>

    <h1 class="display">
      Work organized by business problem, not just industry.
    </h1>

    <p class="lead">
      My background spans healthtech, brand-side retail, consulting, and AI
      workflow projects. The common thread is customer lifecycle design:
      onboarding, adoption, account health, retention, CRM visibility, and
      operating cadence.
    </p>
  </section>

  <section class="section container" aria-labelledby="case-studies">
    <header class="section-head">
      <h2 class="section-title" id="case-studies">Selected case studies</h2>
    </header>

    <ul class="work-list work-list--full">
      {
        workItems.map((entry) => (
          <li class="work-list-item">
            <a href="/work" class="work-link">
              <p class="kicker">{entry.subtitle}</p>
              <h3 class="work-title">{entry.title}</h3>
              <p class="work-summary">{entry.summary}</p>
              <ul class="capabilities-tags" aria-label={`${entry.title} tags`}>
                {entry.tags.map((tag) => (
                  <li>
                    <Tag label={tag} />
                  </li>
                ))}
              </ul>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>