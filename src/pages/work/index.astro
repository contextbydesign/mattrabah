---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/ui/Tag.astro";

const work = [
  {
    id: "neurosync",
    eyebrow: "Healthtech",
    title: "NeuroSync",
    role: "Customer Success, Implementation, and Healthcare Accounts",
    body: "Built the customer-facing function across healthcare accounts where adoption, implementation discipline, and account visibility decided whether the system kept getting used. The job wasn't keeping relationships warm — it was making sure clinical and operational customers had the context, follow-through, and support to stay live.",
    details: [
      "Onboarding and implementation support",
      "Healthcare account management",
      "Adoption and utilization visibility",
      "Customer health and renewal readiness",
    ],
  },
  {
    id: "shinola",
    eyebrow: "Brand-side retail",
    title: "Shinola",
    role: "Portfolio Growth, Salesforce Process, and High-touch CX",
    body: "Managed a corporate account portfolio inside a brand environment where the experience had to feel personal but the operating model still had to scale. The work connected Salesforce discipline, account segmentation, executive-facing communication, and high-touch client experience.",
    details: [
      "Corporate account portfolio management",
      "Salesforce segmentation and process design",
      "Executive-facing account work",
      "Client experience and portfolio growth",
    ],
  },
  {
    id: "context-by-design",
    eyebrow: "Consulting",
    title: "Context By Design",
    role: "Lifecycle Diagnostics, Retention Systems, and CX Strategy",
    body: "Built lifecycle and retention frameworks for service businesses that had customer relationships but limited visibility into the systems behind them. The work made the customer journey easier to see, operate, and improve.",
    details: [
      "Customer journey diagnostics",
      "Onboarding and retention frameworks",
      "Lifecycle maturity models",
      "CRM and operating rhythm recommendations",
    ],
  },
];

const principles = [
  "Customers feel the operating model.",
  "A weak handoff turns a closed deal into implementation risk.",
  "A dashboard is not an operating system.",
  "CRM hygiene is customer-facing, even when it looks internal.",
  "AI should reduce drag without replacing ownership.",
  "Renewal readiness starts long before the renewal conversation.",
];
---

<BaseLayout
  title="Work"
  description="Selected work from Matt Rabah across customer success, implementation, lifecycle systems, CRM discipline, healthtech, retail, and consulting."
>
  <section class="container section hero">
    <div class="stack-300">
      <p class="heading-xxs text-brand">Portfolio</p>
      <h1 class="heading-xxl" style="max-width:16ch">
        Proof across messy customer systems.
      </h1>
      <p class="body-l measure">
        Work from healthtech, retail, and consulting where onboarding, adoption,
        retention, and account visibility had to hold up in practice.
      </p>
    </div>
  </section>

  {
    work.map((w) => (
      <section id={w.id} class="container section work-detail">
        <div class="work-detail-head">
          <p class="heading-xxs text-brand">{w.eyebrow}</p>
          <h2 class="heading-xl">{w.title}</h2>
          <p class="body text-subtlest">{w.role}</p>
        </div>
        <div class="work-detail-body">
          <p class="body-l">{w.body}</p>
          <div class="tag-row">
            {w.details.map((d) => (
              <Tag text={d} color="blue" />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="container section">
    <header class="section-head">
      <h2 class="heading-l">Operating principles</h2>
    </header>
    <p class="body-l measure" style="margin-bottom:var(--space-300)">
      The work isn't about making teams sound more mature than they are. It's
      about giving them fewer places to hide ambiguity: clearer owners, cleaner
      handoffs, better records, stronger preparation, and an honest view of
      account risk.
    </p>
    <div class="tag-row">
      {principles.map((p) => <Tag text={p} />)}
    </div>
  </section>

  <style>
    .hero {
      padding-block: clamp(var(--space-800), 12vw, 7rem);
    }
    .measure {
      max-width: 46rem;
      color: var(--color-text-subtle);
    }
    .section-head {
      margin-bottom: var(--space-300);
    }
    .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-100);
    }

    .work-detail {
      display: grid;
      gap: var(--space-400);
      scroll-margin-top: 4.5rem;
    }
    @media (min-width: 52rem) {
      .work-detail {
        grid-template-columns: 0.8fr 1.2fr;
        align-items: start;
      }
    }
    .work-detail-head {
      display: grid;
      gap: var(--space-100);
    }
    .work-detail-body {
      display: grid;
      gap: var(--space-200);
    }
  </style>
</BaseLayout>
