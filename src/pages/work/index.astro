---
import BaseLayout from "../../layouts/BaseLayout.astro";

const workItems = [
  {
    kicker: "Healthtech",
    title: "Building the customer success function at a healthcare diagnostics startup.",
    summary:
      "A future case study on onboarding, adoption, account health, and renewal readiness across a 32-account clinical portfolio.",
    meta: "NeuroSync · Customer Success Manager · 32 accounts",
  },
  {
    kicker: "Brand-side retail",
    title: "Turning account growth and customer experience into an operating system.",
    summary:
      "A future case study on portfolio discipline, client-facing execution, and executive event strategy at Shinola’s Detroit flagship.",
    meta: "Shinola · CX / account growth · Detroit flagship",
  },
  {
    kicker: "Consulting",
    title: "Designing lifecycle systems for operationally complex service businesses.",
    summary:
      "A future case study on customer journey, retention, onboarding, and lifecycle frameworks through Context By Design.",
    meta: "Context By Design · Independent consulting",
  },
];
---

<BaseLayout
  title="Work"
  description="Selected work from Matt Rabah across customer success, customer experience, implementation, CRM process design, and lifecycle systems."
>
  <section class="hero container">
    <p class="kicker">Selected work</p>

    <h1 class="display">
      Customer lifecycle work across healthtech, retail, and consulting.
    </h1>

    <p class="lead">
      Case studies will focus on the systems behind onboarding, adoption,
      account health, retention, expansion, CRM visibility, and executive-facing
      communication.
    </p>
  </section>

  <section class="section container" aria-labelledby="case-studies">
    <header class="section-head">
      <h2 class="section-title" id="case-studies">Case studies</h2>
    </header>

    <ul class="work-list work-list--full">
      {
        workItems.map((entry) => (
          <li class="work-list-item">
            <a href="/work" class="work-link">
              <p class="kicker">{entry.kicker}</p>
              <h3 class="work-title">{entry.title}</h3>
              <p class="work-summary">{entry.summary}</p>
              <p class="meta">{entry.meta}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>