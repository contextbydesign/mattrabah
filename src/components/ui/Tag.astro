---
/**
 * Tag — ADS Tag component (a chip/label, optionally a link, optionally
 * removable). Distinct from Lozenge: Tag = category/label, Lozenge = status.
 * color: standardLink | grey | blue | green | red | purple | teal | yellow
 */
export interface Props {
  text?: string;
  label?: string;
  href?: string;
  color?: "grey" | "blue" | "green" | "red" | "purple" | "teal" | "yellow";
  variant?: string;
  size?: string;
  icon?: string;
  external?: boolean;
  class?: string;
  "aria-label"?: string;
  rel?: string;
  target?: string;
}

const {
  text,
  label,
  href,
  color = "grey",
  variant,
  size,
  icon,
  external = false,
  class: className,
  "aria-label": ariaLabel,
  rel: relProp,
  target: targetProp,
} = Astro.props;

const content = text ?? label ?? "";
const TagElement = href ? "a" : "span";
const classes = [
  "adg-tag",
  variant ? `adg-tag--${variant}` : `adg-tag--${color}`,
  size ? `adg-tag--${size}` : "",
  href ? "adg-tag--link" : "",
  className,
]
  .filter(Boolean)
  .join(" ");
const rel = relProp ?? (external ? "noopener noreferrer" : undefined);
const target = targetProp ?? (external ? "_blank" : undefined);
---

<TagElement
  class={classes}
  href={href}
  rel={rel}
  target={target}
  aria-label={ariaLabel}
>
  {content}
</TagElement>

<style>
  .adg-tag {
    display: inline-flex;
    align-items: center;
    height: 1.25rem;
    padding-inline: var(--space-075);
    border-radius: var(--radius-100);
    font: var(--font-body);
    text-decoration: none;
    white-space: nowrap;
    background: var(--_bg, var(--color-background-neutral));
    color: var(--_fg, var(--color-text-subtle));
  }
  .adg-tag--link {
    cursor: pointer;
    transition: background-color var(--duration-medium) var(--ease-standard);
  }
  .adg-tag--link:hover {
    text-decoration: underline;
  }
  .adg-tag--link:focus-visible {
    box-shadow: var(--focus-ring);
  }

  .adg-tag--grey {
    --_bg: var(--color-background-neutral);
    --_fg: var(--color-text-subtle);
  }
  .adg-tag--blue {
    --_bg: var(--color-background-accent-blue-subtler);
    --_fg: var(--color-text-accent-blue);
  }
  .adg-tag--green {
    --_bg: var(--color-background-accent-green-subtler);
    --_fg: var(--color-text-accent-green);
  }
  .adg-tag--red {
    --_bg: var(--color-background-accent-red-subtler);
    --_fg: var(--color-text-accent-red);
  }
  .adg-tag--purple {
    --_bg: var(--color-background-accent-purple-subtler);
    --_fg: var(--color-text-accent-purple);
  }
  .adg-tag--teal {
    --_bg: var(--color-background-accent-teal-subtler);
    --_fg: var(--color-text-accent-teal);
  }
  .adg-tag--yellow {
    --_bg: var(--color-background-warning);
    --_fg: var(--color-text-warning);
  }
</style>
