---
/**
 * Tag — quiet capability label. Supports both the current `text` API and the
 * older `label`/`variant`/`size`/`color` usages used across the site.
 */
export interface Props {
  text?: string;
  label?: string;
  href?: string;
  color?: "grey" | "blue" | "green" | "red" | "purple" | "teal" | "yellow";
  variant?: string;
  size?: string;
  icon?: string;
  external?: boolean;
  rel?: string;
  target?: string;
  class?: string;
}

const {
  text,
  label,
  href,
  color = "grey",
  variant,
  size,
  icon,
  external = false,
  rel: relProp,
  target: targetProp,
  class: className,
} = Astro.props;

const content = text ?? label ?? "";
const TagElement = href ? "a" : "span";
const classes = [
  "chip",
  variant ? `chip--${variant}` : `chip--${color}`,
  size ? `chip--${size}` : "",
  href ? "chip--link" : "",
  icon ? "chip--icon" : "",
  className,
]
  .filter(Boolean)
  .join(" ");
const rel = relProp ?? (external ? "noopener noreferrer" : undefined);
const target = targetProp ?? (external ? "_blank" : undefined);
---

<TagElement class={classes} href={href} rel={rel} target={target}>
  {content}
</TagElement>
<style>
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.04em;
    color: var(--color-text-subtle);
    white-space: nowrap;
    text-decoration: none;
  }
  .chip--link {
    transition:
      border-color var(--dur-1) var(--ease),
      color var(--dur-1) var(--ease),
      background-color var(--dur-1) var(--ease);
    cursor: pointer;
  }
  .chip--link:hover {
    border-color: var(--color-accent);
    color: var(--color-text-accent);
    background: var(--color-accent-bg);
  }
  .chip--link:focus-visible {
    box-shadow: var(--focus-ring);
  }
</style>
