---
/**
 * Button — Atlassian Design System button.
 * Appearances: primary | default | subtle | link | warning | danger
 * Renders <a> when `href` is set, else <button>.
 *
 * ADS rules encoded here:
 *  - primary  = brand.bold background, inverse text
 *  - default  = neutral background, default text
 *  - subtle   = transparent, neutral.subtle hover
 *  - link     = looks like a link, button semantics
 *  - 32px (default) / 24px (compact) heights, radius.100
 */
export interface Props {
  href?: string;
  appearance?: "primary" | "default" | "subtle" | "link" | "warning" | "danger";
  spacing?: "default" | "compact";
  type?: "button" | "submit" | "reset";
  iconAfter?: boolean;
  external?: boolean;
  class?: string;
  "aria-label"?: string;
}

const {
  href,
  appearance = "default",
  spacing = "default",
  type = "button",
  external = false,
  class: className,
  "aria-label": ariaLabel,
} = Astro.props;

const Tag = href ? "a" : "button";
const classes = ["btn", `btn--${appearance}`, `btn--${spacing}`, className]
  .filter(Boolean)
  .join(" ");
const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

<Tag
  class={classes}
  href={href}
  type={href ? undefined : type}
  rel={rel}
  target={target}
  aria-label={ariaLabel}
>
  <span class="btn-content"><slot /></span>
  {
    Astro.slots.has("iconAfter") && (
      <span class="btn-icon" aria-hidden="true">
        <slot name="iconAfter" />
      </span>
    )
  }
</Tag>

<style>
  .btn {
    --_bg: var(--color-background-neutral);
    --_bg-hover: var(--color-background-neutral-hovered);
    --_bg-press: var(--color-background-neutral-pressed);
    --_fg: var(--color-text);

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-075);
    border: none;
    border-radius: var(--radius-100);
    background: var(--_bg);
    color: var(--_fg);
    font: var(--font-body);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--duration-medium) var(--ease-standard),
      color var(--duration-medium) var(--ease-standard);
  }
  .btn--default {
    height: 2rem;
    padding-inline: var(--space-150);
  }
  .btn--compact {
    height: 1.5rem;
    padding-inline: var(--space-100);
    font-size: 0.8125rem;
  }

  .btn:hover {
    background: var(--_bg-hover);
  }
  .btn:active {
    background: var(--_bg-press);
  }
  .btn:focus-visible {
    box-shadow: var(--focus-ring);
  }

  .btn--primary {
    --_bg: var(--color-background-brand-bold);
    --_bg-hover: var(--color-background-brand-bold-hovered);
    --_bg-press: var(--color-background-brand-bold-pressed);
    --_fg: var(--color-text-inverse);
  }
  .btn--subtle {
    --_bg: var(--color-background-neutral-subtle);
    --_bg-hover: var(--color-background-neutral-subtle-hovered);
    --_bg-press: var(--color-background-neutral-subtle-pressed);
    --_fg: var(--color-text-subtle);
  }
  .btn--link {
    --_bg: transparent;
    --_bg-hover: transparent;
    --_bg-press: transparent;
    --_fg: var(--color-link);
    height: auto;
    padding-inline: var(--space-050);
  }
  .btn--link:hover {
    text-decoration: underline;
  }
  .btn--warning {
    --_bg: var(--color-background-warning-bold);
    --_bg-hover: var(--color-background-warning-bold);
    --_fg: var(--ads-n-1000);
  }
  .btn--danger {
    --_bg: var(--color-background-danger-bold);
    --_bg-hover: var(--color-background-danger-bold);
    --_fg: var(--color-text-inverse);
  }
  .btn-icon {
    display: inline-flex;
    width: 1em;
    height: 1em;
  }
</style>
