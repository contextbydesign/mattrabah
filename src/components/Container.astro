---
/**
 * Container — width-constrained, centered page gutter.
 * Mirrors the global `.container` rule but as a reusable element so you can
 * pick the semantic tag and an optional narrower "prose" measure.
 */
export interface Props {
  as?: keyof HTMLElementTagNameMap;
  width?: "page" | "prose";
  class?: string;
}

const { as: Tag = "div", width = "page", class: className } = Astro.props;
const classes = ["container-x", `container-x--${width}`, className]
  .filter(Boolean)
  .join(" ");
---

<Tag class={classes}>
  <slot />
</Tag>

<style>
  .container-x {
    width: 100%;
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 5vw, 5rem);
  }
  .container-x--page {
    max-width: var(--measure-page);
  }
  .container-x--prose {
    max-width: var(--measure-prose);
    padding-inline: clamp(1.25rem, 4vw, 2rem);
  }
</style>
