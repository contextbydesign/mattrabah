---
/**
 * Card — ADS elevation.surface.raised container with hover state.
 * Renders <a> (clickable card) when `href` is set, else <article>.
 * Slots: default body, "eyebrow", "footer".
 */
export interface Props {
  href?: string;
  external?: boolean;
  elevation?: "raised" | "flat";
  class?: string;
}

const {
  href,
  external = false,
  elevation = "raised",
  class: className,
} = Astro.props;
const Tag = href ? "a" : "article";
const classes = [
  "card",
  `card--${elevation}`,
  href ? "card--link" : "",
  className,
]
  .filter(Boolean)
  .join(" ");
const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

<Tag class={classes} href={href} rel={rel} target={target}>
  <slot />
</Tag>

<style>
  .card {
    display: block;
    padding: var(--space-300);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-300);
    background: var(--color-elevation-surface-raised);
    color: inherit;
    text-decoration: none;
    transition:
      box-shadow var(--duration-medium) var(--ease-standard),
      border-color var(--duration-medium) var(--ease-standard),
      transform var(--duration-medium) var(--ease-standard);
  }
  .card--raised {
    box-shadow: var(--elevation-shadow-raised);
  }
  .card--link {
    cursor: pointer;
  }
  .card--link:hover {
    border-color: var(--color-border-bold);
    box-shadow: var(--elevation-shadow-overlay);
    transform: translateY(-2px);
  }
  .card--link:focus-visible {
    box-shadow: var(--focus-ring);
  }
</style>
