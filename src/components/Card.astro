---
/**
 * Card — editorial raised surface. Clickable (<a>) shows an arrow affordance
 * and lifts on hover; static (<article>) stays flat. Optional `index` renders
 * a large numbered marker (for selected-work lists — very editorial).
 */
export interface Props {
  href?: string;
  external?: boolean;
  index?: string;
  flat?: boolean;
  class?: string;
}
const {
  href,
  external = false,
  index,
  flat = false,
  class: className,
} = Astro.props;
const Tag = href ? "a" : "article";
const classes = [
  "card",
  flat ? "card--flat" : "",
  href ? "card--link" : "",
  className,
]
  .filter(Boolean)
  .join(" ");
const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

<Tag class={classes} href={href} rel={rel} target={target}>
  {
    index && (
      <span class="card-index meta" aria-hidden="true">
        {index}
      </span>
    )
  }
  <div class="card-body"><slot /></div>
  {
    href && (
      <span class="card-arrow" aria-hidden="true">
        →
      </span>
    )
  }
</Tag>
<style>
  .card {
    position: relative;
    display: block;
    padding: clamp(var(--space-5), 3vw, var(--space-6));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-card);
    transition:
      transform var(--dur-2) var(--ease),
      box-shadow var(--dur-2) var(--ease),
      border-color var(--dur-1) var(--ease);
  }
  .card--flat {
    box-shadow: none;
    background: transparent;
    border-color: var(--color-border);
  }
  .card--link {
    cursor: pointer;
  }
  .card--link:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
    border-color: var(--color-border-accent);
  }
  .card--link:focus-visible {
    box-shadow: var(--focus-ring);
  }
  .card-index {
    display: block;
    font-size: var(--fs-meta);
    color: var(--color-text-faint);
    margin-bottom: var(--space-3);
  }
  .card-arrow {
    position: absolute;
    top: clamp(var(--space-5), 3vw, var(--space-6));
    right: clamp(var(--space-5), 3vw, var(--space-6));
    color: var(--color-text-faint);
    transition:
      transform var(--dur-1) var(--ease),
      color var(--dur-1) var(--ease);
  }
  .card--link:hover .card-arrow {
    color: var(--color-text-accent);
    transform: translate(3px, -3px);
  }
</style>
