---
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
}

const SITE_NAME = "Matt Rabah";
const DEFAULT_DESCRIPTION =
  "Matt Rabah builds customer lifecycle systems, practical AI workflows, and operating models for complex customer-facing teams.";

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/inter@5.0.8/index.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/inter@5.0.8/500.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/inter@5.0.8/600.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5.0.8/index.css"
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label={`${SITE_NAME}, home`}>
          <span class="brand-mark" aria-hidden="true">m</span>
          <span class="brand-name">{SITE_NAME}</span>
        </a>

        <nav class="site-nav" id="primary-navigation" aria-label="Primary">
          <ul>
            <li><a href="/work">Work</a></li>
            <li><a href="/tools">AI Tools</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
            <li class="theme-toggle-item">
              <button
                class="theme-toggle"
                type="button"
                aria-label="Switch to dark mode"
              >
                <span class="theme-toggle-icon" aria-hidden="true">☾</span>
              </button>
            </li>
          </ul>
        </nav>

        <div class="header-actions">
          <button
            class="search-toggle"
            type="button"
            aria-label="Open search"
            aria-controls="site-search-panel"
            aria-expanded="false"
          >
            Search
          </button>

          <a class="header-cta" href="/contact">
            Start a conversation
            <span aria-hidden="true">→</span>
          </a>

          <button
            class="nav-toggle"
            type="button"
            aria-label="Open navigation"
            aria-controls="primary-navigation"
            aria-expanded="false"
          >
            <span class="nav-toggle-line"></span>
            <span class="nav-toggle-line"></span>
            <span class="nav-toggle-line"></span>
          </button>
        </div>
      </div>

      <div
        class="site-search-panel"
        id="site-search-panel"
        hidden
        aria-label="Site search"
      >
        <div class="container search-inner">
          <form class="site-search-form" role="search">
            <label class="search-label" for="site-search-input">
              Search the site
            </label>

            <div class="search-input-row">
              <input
                class="site-search-input"
                id="site-search-input"
                type="search"
                placeholder="Search work, tools, writing, about..."
                autocomplete="off"
                spellcheck="false"
              />

              <button class="search-close" type="button">Close</button>
            </div>
          </form>

          <div class="search-results-wrap">
            <p class="search-help" id="search-help">
              Try “AI tools,” “implementation,” “Shinola,” “customer health,” or
              “renewal.”
            </p>

            <ul
              class="search-results"
              id="search-results"
              aria-live="polite"
              aria-label="Search results"
            >
            </ul>
          </div>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-text">© {year} {SITE_NAME} — Detroit, MI</p>

        <ul class="footer-links">
          <li><a href="mailto:hello@mattrabah.com">Email</a></li>
          <li>
            <a
              href="https://www.linkedin.com/in/mattrabah/"
              rel="me noopener"
              target="_blank"
            >
              LinkedIn
            </a>
          </li>
          <li><a href="/blog">Writing</a></li>
          <li><a href="/style-guide">Style Guide</a></li>
          <li><a href="/tag-test">Tag Test</a></li>
        </ul>
      </div>
    </footer>

    <script>
      // @ts-nocheck
      // Search index and UI interaction script (plain JavaScript)

      const navToggle = document.querySelector(".nav-toggle");
      const nav = document.querySelector(".site-nav");

      const searchToggle = document.querySelector(".search-toggle");
      const searchPanel = document.querySelector(".site-search-panel");
      const searchInput = document.querySelector(".site-search-input");
      const searchClose = document.querySelector(".search-close");
      const searchResults = document.querySelector(".search-results");
      const searchHelp = document.querySelector(".search-help");

      const themeToggle = document.querySelector(".theme-toggle");
      const themeToggleIcon = document.querySelector(".theme-toggle-icon");

      /** @type {{title:string,url:string,type:string,description:string,keywords:string}[]} */
      const searchIndex = [
        {
          title: "Home",
          url: "/",
          type: "Overview",
          description:
            "Customer lifecycle systems, practical AI workflows, implementation discipline, account health, retention, and change management.",
          keywords:
            "home customer lifecycle systems ai workflows implementation cx customer success retention adoption account health",
        },
        {
          title: "Work",
          url: "/work",
          type: "Case studies",
          description:
            "Selected work across healthtech, brand-side retail, consulting, portfolio growth, onboarding, adoption, and customer lifecycle systems.",
          keywords:
            "work case studies shinola neurosync context by design healthtech retail consulting implementation portfolio growth salesforce onboarding adoption",
        },
        {
          title: "AI Tools",
          url: "/tools",
          type: "Tools",
          description:
            "Practical AI tools for handoff risk, customer health, renewal readiness, QBR preparation, and CRM field quality.",
          keywords:
            "ai tools handoff risk checker customer health signal mapper renewal readiness diagnostic qbr crm field quality implementation customer success",
        },
        {
          title: "Blog",
          url: "/blog",
          type: "Writing",
          description:
            "Writing on AI in customer experience, implementation, customer health, lifecycle operations, and customer-facing systems.",
          keywords:
            "blog writing articles ai cx implementation customer health sales handoff lifecycle operations customer success",
        },
        {
          title: "About",
          url: "/about",
          type: "Profile",
          description:
            "About Matt Rabah, a Detroit-based customer experience, customer success, and implementation professional.",
          keywords:
            "about matt rabah detroit customer experience customer success implementation msu shinola neurosync context by design",
        },
        {
          title: "Contact",
          url: "/contact",
          type: "Contact",
          description:
            "Contact Matt Rabah for customer experience, implementation, customer success, lifecycle systems, and AI workflow work.",
          keywords:
            "contact email linkedin matt rabah cx implementation customer success ai workflows",
        },
        {
          title: "Style Guide",
          url: "/style-guide",
          type: "Reference",
          description:
            "Design tokens, color swatches, type samples, and tag variants for the site system.",
          keywords:
            "style guide tokens color swatches type samples tag variants reference",
        },
        {
          title: "Tag Test",
          url: "/tag-test",
          type: "Reference",
          description:
            "Light and dark preview of tag variants, sizes, and icon states.",
          keywords: "tag test variants sizes icons light dark preview",
        },
      ];
        const closeNavigation = () => {
        if (navToggle) {
          navToggle.setAttribute("aria-expanded", "false");
          navToggle.setAttribute("aria-label", "Open navigation");
        }

        if (nav) nav.classList.remove("is-open");
        document.body.classList.remove("nav-open");
      };

      /**
       * @param {string} value
       * @returns {string}
       */
      const normalizeText = (value) => value.toLowerCase().trim();

      /**
       * @param {string} query
       */
      const renderSearchResults = (query) => {
        if (!searchResults || !searchHelp) return;
        const normalizedQuery = normalizeText(String(query));
        searchResults.innerHTML = "";

        if (!normalizedQuery) {
          if (searchHelp instanceof HTMLElement) searchHelp.hidden = false;
          return;
        }

        /** @type {string[]} */
        const terms = normalizedQuery.split(/\s+/).filter(Boolean);

        const matches = searchIndex
          .map((item) => {
            const haystack = normalizeText(
              `${item.title} ${item.type} ${item.description} ${item.keywords}`,
            );

            const score = terms.reduce((total, term) => {
              if (item.title.toLowerCase().includes(term)) return total + 4;
              if (item.type.toLowerCase().includes(term)) return total + 3;
              if (item.description.toLowerCase().includes(term)) return total + 2;
              if (haystack.includes(term)) return total + 1;
              return total;
            }, 0);

            return Object.assign({}, item, { score });
          })
          .filter((item) => item.score > 0)
          .sort((a, b) => b.score - a.score || a.title.localeCompare(b.title));

        if (searchHelp instanceof HTMLElement) searchHelp.hidden = matches.length > 0;

        if (matches.length === 0) {
          const emptyItem = document.createElement("li");
          emptyItem.className = "search-empty";
          emptyItem.textContent = `No results for “${query}.”`;
          searchResults.appendChild(emptyItem);
          return;
        }

        matches.forEach((item) => {
          const result = document.createElement("li");
          result.className = "search-result-item";

          const link = document.createElement("a");
          link.className = "search-result-link";
          link.href = item.url;

          const type = document.createElement("span");
          type.className = "search-result-type";
          type.textContent = item.type;

          const title = document.createElement("strong");
          title.className = "search-result-title";
          title.textContent = item.title;

          const description = document.createElement("span");
          description.className = "search-result-description";
          description.textContent = item.description;

          link.append(type, title, description);
          result.appendChild(link);
          searchResults.appendChild(result);
        });
      };

      const openSearch = () => {
        if (searchPanel) searchPanel.removeAttribute("hidden");
        if (searchToggle) {
          searchToggle.setAttribute("aria-expanded", "true");
          searchToggle.setAttribute("aria-label", "Close search");
        }

        document.body.classList.add("search-open");
        closeNavigation();

        window.requestAnimationFrame(() => {
          if (searchInput instanceof HTMLInputElement) searchInput.focus();
        });
      };

      const closeSearch = () => {
        if (searchPanel) searchPanel.setAttribute("hidden", "");
        if (searchToggle) {
          searchToggle.setAttribute("aria-expanded", "false");
          searchToggle.setAttribute("aria-label", "Open search");
        }
        document.body.classList.remove("search-open");

        if (searchInput instanceof HTMLInputElement) searchInput.value = "";

        renderSearchResults("");
      };

      /** @param {'light'|'dark'} theme */
      const applyTheme = (theme) => {
        document.documentElement.dataset.theme = theme;
        localStorage.setItem("theme", theme);

        if (themeToggle && themeToggleIcon) {
          const isDark = theme === "dark";

          themeToggle.setAttribute(
            "aria-label",
            isDark ? "Switch to light mode" : "Switch to dark mode",
          );

          themeToggleIcon.textContent = isDark ? "☼" : "☾";
        }
      };

      const savedTheme = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;

      applyTheme(savedTheme === "light" || savedTheme === "dark" ? savedTheme : prefersDark ? "dark" : "light");

      if (themeToggle) {
        themeToggle.addEventListener("click", () => {
          const currentTheme = document.documentElement.dataset.theme;
          applyTheme(currentTheme === "dark" ? "light" : "dark");
        });
      }

      if (navToggle) {
        navToggle.addEventListener("click", () => {
          const isOpen = navToggle.getAttribute("aria-expanded") === "true";

          navToggle.setAttribute("aria-expanded", String(!isOpen));
          navToggle.setAttribute(
            "aria-label",
            isOpen ? "Open navigation" : "Close navigation",
          );

          if (nav) nav.classList.toggle("is-open", !isOpen);
          document.body.classList.toggle("nav-open", !isOpen);

          if (!isOpen) {
            closeSearch();
          }
        });
      }

      if (searchToggle) {
        searchToggle.addEventListener("click", () => {
          const isOpen = searchToggle.getAttribute("aria-expanded") === "true";
          isOpen ? closeSearch() : openSearch();
        });
      }

      if (searchClose) searchClose.addEventListener("click", closeSearch);

      if (searchInput) {
        searchInput.addEventListener("input", (event) => {
          const input = event.currentTarget;
          if (!(input instanceof HTMLInputElement)) return;
          renderSearchResults(input.value);
        });
      }

      if (nav) {
        nav.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", closeNavigation);
        });
      }

      if (searchResults) {
        searchResults.addEventListener("click", (event) => {
          const target = event.target;
          if (target instanceof Element && target.closest("a")) {
            closeSearch();
          }
        });
      }

      window.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        closeNavigation();
        closeSearch();
      });
    </script>
  </body>
</html>
