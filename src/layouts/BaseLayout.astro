---
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
}

const SITE_NAME = "Matt Rabah";
const DEFAULT_DESCRIPTION =
  "Matt Rabah builds customer lifecycle systems, practical AI workflows, and operating models for complex customer-facing teams.";

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label={`${SITE_NAME}, home`}>
          {SITE_NAME}
        </a>

        <nav class="site-nav" aria-label="Primary">
          <ul>
            <li><a href="/work">Work</a></li>
            <li><a href="/tools">AI Tools</a></li>
            <li><a href="/blog">Writing</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-text">© {year} {SITE_NAME} · Detroit, Michigan</p>

        <ul class="footer-links">
          <li><a href="mailto:hello@mattrabah.com">Email</a></li>
          <li>
            <a
              href="https://www.linkedin.com/in/mattrabah/"
              rel="me noopener"
              target="_blank"
            >
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </footer>
  </body>
</html>