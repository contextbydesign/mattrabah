---
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
}

const SITE_NAME = "Matt Rabah";
const DEFAULT_DESCRIPTION =
  "Matt Rabah builds customer lifecycle systems, practical AI workflows, and operating models for complex customer-facing teams.";

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;
const year = new Date().getFullYear();

// 1. Get the current page URL path
const currentPath = Astro.url.pathname;

// 2. Define your navigation links
const navItems = [
  { href: "/work", label: "Work" },
  { href: "/tools", label: "AI Tools" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label={`${SITE_NAME}, home`}>
          {SITE_NAME}
        </a>

        <nav class="site-nav" aria-label="Primary">
          <ul>
            {navItems.map((item) => {
              const isActive =
                currentPath === item.href || currentPath.startsWith(item.href + "/");
              
              return (
                <li>
                  <a
                    href={item.href}
                    class={isActive ? "active" : ""}
                    aria-current={isActive ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
            <li class="theme-toggle-wrapper">
              <button id="theme-toggle" aria-label="Toggle Dark Mode">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="moon-icon"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sun-icon"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
              </button>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-text">© {year} {SITE_NAME} · Detroit, Michigan</p>

        <ul class="footer-links">
          <li>
            <a href="mailto:rabah.matthew@gmail.com" aria-label="Email Matt Rabah">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-icon"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <span>Email</span>
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/mattrabah/" rel="me noopener" target="_blank" aria-label="Matt Rabah on LinkedIn">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-icon"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
              <span>LinkedIn</span>
            </a>
          </li>
          <li>
            <a href="https://instagram.com/yourhandle" rel="me noopener" target="_blank" aria-label="Matt Rabah on Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-icon"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
              <span>Instagram</span>
            </a>
          </li>
        </ul>
      </div>
    </footer>

    <script>
      const toggleBtn = document.getElementById('theme-toggle');
      const toggleTheme = () => {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
      };
      toggleBtn?.addEventListener('click', toggleTheme);
    </script>
  </body>
</html>