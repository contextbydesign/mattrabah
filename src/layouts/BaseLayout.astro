---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Matt Rabah",
  description = "Customer experience, implementation, and customer success work focused on lifecycle systems, adoption, retention, and commercial outcomes.",
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/work", label: "Work" },
  { href: "/blog", label: "Blog" },
  { href: "/tools", label: "AI Tools" },
  { href: "/contact", label: "Contact" },
];

const isActive = (href: string) => {
  const normalizedHref = href.replace(/\/$/, "") || "/";

  if (normalizedHref === "/") {
    return currentPath === "/";
  }

  return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
};

const pageTitle = title === "Matt Rabah" ? title : `${title} | Matt Rabah`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{pageTitle}</title>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="site-shell site-header__inner">
        <a class="site-mark" href="/" aria-label="Matt Rabah home">
          Matt Rabah
        </a>

        <nav class="nav" aria-label="Primary navigation">
          {
            navItems.map((item) => {
              const active = isActive(item.href);

              return (
                <a
                  href={item.href}
                  class="nav-link"
                  aria-current={active ? "page" : undefined}
                  data-active={active ? "true" : "false"}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>
  </body>
</html>