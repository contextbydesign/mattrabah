---
/**
 * BaseLayout (ADS edition) — sets up tokens, top navigation, theme toggle,
 * and the flicker-free theme bootstrap. Light/dark driven entirely by
 * data-theme on <html> + semantic tokens.
 */
import "../styles/base.css";
import Button from "../components/Button.astro";

export interface Props {
  title: string;
  description?: string;
}
const SITE = "Matt Rabah";
const { title, description = "Customer lifecycle systems, practical AI workflows, and operating models for customer-facing teams." } = Astro.props;
const fullTitle = title === SITE ? title : `${title} — ${SITE}`;
const year = new Date().getFullYear();
const nav = [
  { href: "/work", label: "Work" },
  { href: "/tools", label: "AI Tools" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- Flicker-free theme: set data-theme before paint -->
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        const dark = saved ? saved === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="topnav">
      <div class="container topnav-inner">
        <a href="/" class="topnav-brand" aria-label={`${SITE}, home`}>
          <span class="topnav-mark" aria-hidden="true">MR</span>
          <span class="topnav-name">{SITE}</span>
        </a>

        <nav class="topnav-links" aria-label="Primary">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>

        <div class="topnav-actions">
          <button class="theme-toggle" type="button" aria-label="Toggle theme">
            <svg class="theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0-5v3m0 14v3m10-10h-3M5 12H2m15.5-6.5-2 2m-7 7-2 2m11 0-2-2m-7-7-2-2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <svg class="theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" fill="currentColor"/></svg>
          </button>
          <Button href="/contact" appearance="primary" spacing="compact">Start a conversation</Button>
        </div>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="stack-100">
          <p class="heading-s">{SITE}</p>
          <p class="body-s">CX, customer success, and implementation systems.<br />Detroit, MI · Open to new roles.</p>
        </div>
        <nav class="stack-100" aria-label="Site">
          <p class="heading-xxs">Site</p>
          {nav.map((item) => <a class="body-s footer-link" href={item.href}>{item.label}</a>)}
        </nav>
        <nav class="stack-100" aria-label="Elsewhere">
          <p class="heading-xxs">Elsewhere</p>
          <a class="body-s footer-link" href="mailto:rabah.matthew@gmail.com">Email</a>
          <a class="body-s footer-link" href="https://www.linkedin.com/in/mattrabah/" target="_blank" rel="me noopener">LinkedIn</a>
        </nav>
      </div>
      <div class="container"><p class="body-s footer-legal">© {year} {SITE} — Detroit, MI</p></div>
    </footer>

    <script is:inline>
      const btn = document.querySelector(".theme-toggle");
      btn?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
      });
    </script>

    <style>
      .topnav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: color-mix(in srgb, var(--color-elevation-surface) 90%, transparent);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--color-border);
      }
      .topnav-inner {
        height: 3.5rem;
        display: flex;
        align-items: center;
        gap: var(--space-400);
      }
      .topnav-brand { display: inline-flex; align-items: center; gap: var(--space-100); color: var(--color-text); text-decoration: none; font: var(--font-heading-s); }
      .topnav-mark {
        display: inline-grid; place-items: center;
        width: 1.75rem; height: 1.75rem;
        border-radius: var(--radius-100);
        background: var(--color-background-brand-bold);
        color: var(--color-text-inverse);
        font: var(--font-body-s); font-weight: var(--font-weight-bold);
        letter-spacing: 0.02em;
      }
      .topnav-links { display: flex; gap: var(--space-300); margin-inline-start: auto; }
      .topnav-links a { color: var(--color-text-subtle); font: var(--font-body); font-weight: var(--font-weight-medium); text-decoration: none; }
      .topnav-links a:hover { color: var(--color-text); }
      .topnav-actions { display: flex; align-items: center; gap: var(--space-150); }
      .theme-toggle {
        display: inline-grid; place-items: center;
        width: 2rem; height: 2rem; border: none;
        border-radius: var(--radius-100);
        background: var(--color-background-neutral-subtle);
        color: var(--color-icon); cursor: pointer;
      }
      .theme-toggle:hover { background: var(--color-background-neutral-subtle-hovered); }
      .theme-toggle svg { width: 1.25rem; height: 1.25rem; }
      .theme-icon-moon { display: none; }
      :root[data-theme="dark"] .theme-icon-sun { display: none; }
      :root[data-theme="dark"] .theme-icon-moon { display: block; }

      @media (max-width: 48rem) {
        .topnav-links { display: none; }
        .topnav-links { margin-inline-start: auto; }
      }

      .site-footer {
        margin-top: var(--space-800);
        padding-block: var(--space-600) var(--space-400);
        background: var(--color-elevation-surface);
        border-top: 1px solid var(--color-border);
        display: grid;
        gap: var(--space-400);
      }
      .footer-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr;
        gap: var(--space-400);
      }
      .footer-link { color: var(--color-text-subtle); text-decoration: none; }
      .footer-link:hover { color: var(--color-text); }
      .footer-legal { color: var(--color-text-subtlest); }
      @media (max-width: 48rem) { .footer-grid { grid-template-columns: 1fr; } }
    </style>
  </body>
</html>
