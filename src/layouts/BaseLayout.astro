---
import "../styles/base.css";
import Button from "../components/Button.astro";

export interface Props {
  title: string;
  description?: string;
}
const SITE = "Matt Rabah";
const {
  title,
  description = "Detroit-based CX and customer success. Customer lifecycle systems, practical AI workflows, and operating models for customer-facing teams.",
} = Astro.props;
const fullTitle =
  title === SITE ? `${SITE} — CX & Customer Success` : `${title} — ${SITE}`;
const year = new Date().getFullYear();
const nav = [
  { href: "/work", label: "Work" },
  { href: "/tools", label: "Tools" },
  { href: "/blog", label: "Writing" },
  { href: "/about", label: "About" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Preload the two faces visible above the fold: display + UI -->
    <link
      rel="preload"
      href="/fonts/tiempos/Tiempos Headline/Tiempos-Headline-Semibold-Desktop.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/sohne/Sohne/sohne-book.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (() => {
        const s = localStorage.getItem("theme");
        const d = s
          ? s === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = d ? "dark" : "light";
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="container masthead-inner">
        <a href="/" class="wordmark" aria-label={`${SITE}, home`}>
          <span class="wordmark-name">MR</span>
          <span class="wordmark-full">
            <span class="wordmark-line1">Matt Rabah</span>
            <span class="brand-signal" aria-hidden="true">
              <span>CX</span>
              <span>AI</span>
              <span>CS</span>
              <span>CRM</span>
              <span>OPS</span>
              <span>GTM</span>
              <span>VOC</span>
            </span>
          </span>
        </a>

        <nav class="nav" aria-label="Primary">
          {nav.map((i) => <a href={i.href}>{i.label}</a>)}
        </nav>

        <div class="masthead-actions">
          <button class="theme-btn" type="button" aria-label="Toggle theme">
            <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"
              ><circle cx="12" cy="12" r="4.2" fill="currentColor"></circle><g
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                ><path
                  d="M12 2.5v2.6M12 18.9v2.6M21.5 12h-2.6M5.1 12H2.5M18.4 5.6l-1.8 1.8M7.4 16.6l-1.8 1.8M18.4 18.4l-1.8-1.8M7.4 7.4 5.6 5.6"
                ></path></g
              ></svg
            >
            <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M20 14.3A8 8 0 1 1 9.7 4 6.4 6.4 0 0 0 20 14.3Z"
                fill="currentColor"></path></svg
            >
          </button>
          <span class="masthead-cta"
            ><Button href="/contact" variant="ghost" size="sm" arrow
              >Contact</Button
            ></span
          >
          <button
            class="nav-toggle"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"><span></span><span></span></button
          >
        </div>
      </div>
      <div class="mobile-nav" hidden>
        <div class="container stack-2">
          {nav.map((i) => <a href={i.href}>{i.label}</a>)}
          <a href="/contact">Contact</a>
        </div>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-brand stack-3">
          <a href="/" class="footer-word">Matt Rabah</a>
          <p class="body-sm" style="max-width:28ch">
            Customer lifecycle systems and practical AI workflows for
            customer-facing teams. Detroit, MI.
          </p>
          <p class="meta" style="color:var(--color-text-accent)">
            — Open to new roles
          </p>
        </div>
        <nav class="footer-col" aria-label="Site">
          <p class="footer-col-title">Site</p>
          {nav.map((i) => <a href={i.href}>{i.label}</a>)}
        </nav>
        <nav class="footer-col" aria-label="Contact">
          <p class="footer-col-title">Contact</p>
          <a href="mailto:rabah.matthew@gmail.com">Email</a>
          <a
            href="https://www.linkedin.com/in/mattrabah/"
            target="_blank"
            rel="me noopener">LinkedIn</a
          >
        </nav>
      </div>
      <div class="container footer-base">
        <p class="meta">© {year} {SITE}</p>
        <p class="meta">Detroit, Michigan</p>
      </div>
    </footer>

    <script is:inline>
      document.querySelector(".theme-btn")?.addEventListener("click", () => {
        const n =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = n;
        localStorage.setItem("theme", n);
      });
      const t = document.querySelector(".nav-toggle"),
        m = document.querySelector(".mobile-nav");
      t?.addEventListener("click", () => {
        const open = t.getAttribute("aria-expanded") === "true";
        t.setAttribute("aria-expanded", String(!open));
        if (m) m.hidden = open;
      });
    </script>

    <style>
      .masthead {
        position: sticky;
        top: 0;
        z-index: 100;
        background: color-mix(in srgb, var(--color-surface) 86%, transparent);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--color-border);
      }
      .masthead-inner {
        display: flex;
        align-items: center;
        gap: var(--space-6);
        min-height: 4.25rem;
      }
      /* Wordmark: Söhne Breit monogram + name. Breit's width gives it presence. */
      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        text-decoration: none;
        color: var(--color-text);
      }
      .wordmark-name {
        display: inline-grid;
        place-items: center;
        width: 2.15rem;
        height: 2.15rem;
        border-radius: var(--radius-sm);
        background: var(--color-text);
        color: var(--color-surface);
        font-family: var(--font-wide);
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.02em;
      }
      .wordmark-full {
        display: grid;
        line-height: 1.1;
      }
      .wordmark-line1 {
        font-family: var(--font-wide);
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.01em;
      }

      /* Animated discipline signal — a small clay pill that rotates through
         the disciplines. Count-agnostic: add/remove <span>s freely. */
      .brand-signal {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 3rem;
        height: 1.05rem;
        margin-top: 3px;
        overflow: hidden;
        border-radius: var(--radius-pill);
        background: var(--color-accent-bg);
        border: 1px solid var(--color-border-accent);
      }
      .brand-signal span {
        position: absolute;
        inset: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-mono);
        font-size: 0.5625rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-text-accent);
        opacity: 0;
        transform: translateY(90%);
        animation: brand-signal 14s infinite;
      }
      /* 7 items → each occupies 1/7 of the cycle. Delays are evenly spaced;
         keeping them explicit is clearer than calc and easy to extend. */
      .brand-signal span:nth-child(1) {
        animation-delay: 0s;
      }
      .brand-signal span:nth-child(2) {
        animation-delay: 2s;
      }
      .brand-signal span:nth-child(3) {
        animation-delay: 4s;
      }
      .brand-signal span:nth-child(4) {
        animation-delay: 6s;
      }
      .brand-signal span:nth-child(5) {
        animation-delay: 8s;
      }
      .brand-signal span:nth-child(6) {
        animation-delay: 10s;
      }
      .brand-signal span:nth-child(7) {
        animation-delay: 12s;
      }
      @keyframes brand-signal {
        0% {
          opacity: 0;
          transform: translateY(90%);
        }
        4%,
        11% {
          opacity: 1;
          transform: translateY(0);
        }
        15%,
        100% {
          opacity: 0;
          transform: translateY(-90%);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .brand-signal span {
          animation: none;
          opacity: 0;
          transform: none;
        }
        .brand-signal span:first-child {
          opacity: 1;
        }
      }
      .nav {
        display: flex;
        gap: var(--space-6);
        margin-inline-start: auto;
      }
      .nav a {
        font-family: var(--font-sans);
        font-size: var(--fs-body-sm);
        font-weight: var(--w-med);
        color: var(--color-text-subtle);
        text-decoration: none;
      }
      .nav a:hover {
        color: var(--color-text-accent);
      }
      .masthead-actions {
        display: flex;
        align-items: center;
        gap: var(--space-3);
      }
      .theme-btn {
        display: inline-grid;
        place-items: center;
        width: 2.15rem;
        height: 2.15rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-pill);
        background: transparent;
        color: var(--color-text-subtle);
        cursor: pointer;
        transition:
          color var(--dur-1),
          border-color var(--dur-1);
      }
      .theme-btn:hover {
        color: var(--color-text-accent);
        border-color: var(--color-border-accent);
      }
      .theme-btn svg {
        width: 1.15rem;
        height: 1.15rem;
      }
      .i-moon {
        display: none;
      }
      :root[data-theme="dark"] .i-sun {
        display: none;
      }
      :root[data-theme="dark"] .i-moon {
        display: block;
      }
      .nav-toggle {
        display: none;
        flex-direction: column;
        gap: 5px;
        width: 2.4rem;
        height: 2.4rem;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        background: transparent;
        cursor: pointer;
      }
      .nav-toggle span {
        width: 1.1rem;
        height: 1.5px;
        background: var(--color-text);
      }
      .mobile-nav {
        border-top: 1px solid var(--color-border);
        padding-block: var(--space-4);
      }
      .mobile-nav a {
        display: block;
        padding: var(--space-2) 0;
        color: var(--color-text);
        font-size: var(--fs-h4);
        font-family: var(--font-display);
      }

      @media (max-width: 46rem) {
        .nav,
        .masthead-cta {
          display: none;
        }
        .nav-toggle {
          display: flex;
        }
        .masthead-actions {
          margin-inline-start: auto;
        }
        .brand-signal {
          width: 2.6rem;
        }
      }

      .footer {
        margin-top: var(--space-9);
        border-top: 1px solid var(--color-border);
        background: var(--color-surface-sunken);
      }
      .footer-inner {
        display: grid;
        grid-template-columns: 1.6fr 1fr 1fr;
        gap: var(--space-6);
        padding-block: var(--space-8) var(--space-6);
      }
      .footer-word {
        font-family: var(--font-display);
        font-weight: var(--w-semi);
        font-size: 1.6rem;
        letter-spacing: -0.02em;
        color: var(--color-text);
        text-decoration: none;
      }
      .footer-col {
        display: grid;
        gap: var(--space-3);
        align-content: start;
      }
      .footer-col-title {
        font-family: var(--font-mono);
        font-size: var(--fs-meta);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-text-faint);
      }
      .footer-col a {
        color: var(--color-text-subtle);
        font-size: var(--fs-body-sm);
        text-decoration: none;
      }
      .footer-col a:hover {
        color: var(--color-text-accent);
      }
      .footer-base {
        display: flex;
        justify-content: space-between;
        padding-block: var(--space-5);
        border-top: 1px solid var(--color-border);
      }
      @media (max-width: 46rem) {
        .footer-inner {
          grid-template-columns: 1fr 1fr;
        }
        .footer-brand {
          grid-column: 1 / -1;
        }
      }
    </style>
  </body>
</html>
