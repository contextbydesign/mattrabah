---
/**
 * Tag — quiet capability label. Hairline chip, mono caps, optional link.
 * Editorial restraint: tags are texture, not decoration — one tone only.
 */
export interface Props {
  text: string;
  href?: string;
  external?: boolean;
  class?: string;
  color?: string;
  rel?: string;
  target?: string;
}
const { text, href, external = false, class: className } = Astro.props;
const TagEl = href ? "a" : "span";
const classes = ["chip", href ? "chip--link" : "", className]
  .filter(Boolean)
  .join(" ");
const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

<TagEl class={classes} href={href} rel={rel} target={target}>{text}</TagEl>
<style>
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.04em;
    color: var(--color-text);
    white-space: nowrap;
    text-decoration: none;
  }
  .chip--link {
    transition:
      border-color var(--dur-1) var(--ease),
      color var(--dur-1) var(--ease),
      background-color var(--dur-1) var(--ease);
    cursor: pointer;
  }
  .chip--link:hover {
    border-color: var(--color-accent);
    color: var(--color-text-accent);
    background: var(--color-accent-bg);
  }
  .chip--link:focus-visible {
    box-shadow: var(--focus-ring);
  }
</style>
